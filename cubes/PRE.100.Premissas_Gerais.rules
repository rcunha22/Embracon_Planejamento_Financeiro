SKIPCHECK;

[] = N:
  IF( ELISANC( 'ALL.D.Versao', 'Dynamic Versions', !ALL.D.Versao ) <> 0
  , CONTINUE
  , STET );

['PRE.M.100.Premissas_Gerais':'PRE.M.100.Premissas_Gerais':'Periodo Inicial da Projecao'] = N:
  IF( DB( 'PRE.100.Premissas_Gerais'
        , DB( 'SYS.200.Time_Travel', !ALL.D.Ano, !ALL.D.Mes, '-1', 'Ano' )
        , DB( 'SYS.200.Time_Travel', !ALL.D.Ano, !ALL.D.Mes, '-1', 'Mes' )
        , !ALL.D.Versao
        , 'Periodo Inicial da Projecao') >= 1
  ,  DB( 'PRE.100.Premissas_Gerais'
        , DB( 'SYS.200.Time_Travel', !ALL.D.Ano, !ALL.D.Mes, '-1', 'Ano' )
        , DB( 'SYS.200.Time_Travel', !ALL.D.Ano, !ALL.D.Mes, '-1', 'Mes' )
        , !ALL.D.Versao
        , 'Periodo Inicial da Projecao') + 1
  , STET);





