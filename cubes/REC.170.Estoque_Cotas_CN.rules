SKIPCHECK;

#Region - Outros
# --------------------------------------------------------------------------------------------
# Name: Dynamic Versions
# Desc: Libera Regras apenas para Versões Dinâmicas
# Date: 22/09/2026
# Author: Willian Maeda
# --------------------------------------------------------------------------------------------

[] = N:
  IF( ELISANC( 'ALL.D.Versao', 'Dynamic Versions', !ALL.D.Versao ) <> 0
  , CONTINUE
  , STET );

# --------------------------------------------------------------------------------------------
# Name:
# Desc: 
# Date: 21/09/2026
# Author: Gregorie Amaral
# --------------------------------------------------------------------------------------------

['REC.M.170.Estoque_Cotas_CN':'Flag Aux'] = N:

IF(!REC.D.Safra_CN @= '001'
   &
   DB('PRE.100.Premissas_Gerais'
      , SUBST(!ALL.D.Periodo_Projecao,5,10)
      , SUBST(!ALL.D.Periodo_Projecao,1,3)
      , !ALL.D.Versao
      , 'Periodo Inicial da Projecao'
   ) = 1

, 1

, CONTINUE
  );

['REC.M.170.Estoque_Cotas_CN':'Flag Aux'] = N:

IF(
DB('REC.170.Estoque_Cotas_CN'
   , !ALL.D.Versao
   , ATTRS('REC.D.Safra_CN',!REC.D.Safra_CN,'Safra Anterior')
   , ATTRS('ALL.D.Periodo_Projecao',!ALL.D.Periodo_Projecao,'Previous Period')
   , !ALL.D.Canal
   , !ALL.D.Especie
   , !ALL.D.Tabela
   , !ALL.D.Plano
   , !ALL.D.Prazo
   , !ALL.D.Regional
   , 'Flag Aux'
) = 1

, 1

, CONTINUE
);


# --------------------------------------------------------------------------------------------
# Name: Cotas Valor
# Desc: Calcula as cotas vendidas apenas para o período correspondente à safra
# Date: 21/09/2026
# Author: Gregorie Amaral
# --------------------------------------------------------------------------------------------

['REC.M.170.Estoque_Cotas_CN':'REC.M.170.Estoque_Cotas_CN':'Cotas Valor'] = N:

IF(['REC.M.170.Estoque_Cotas_CN':'REC.M.170.Estoque_Cotas_CN':'Flag Aux'] = 1
, DB('REC.140.Vendas_Projecao'
      , SUBST( !ALL.D.Periodo_Projecao, 5, 10 ) 
      , SUBST( !ALL.D.Periodo_Projecao, 1, 3 )
      , !ALL.D.Versao
      , !ALL.D.Canal
      , !ALL.D.Especie
      , !ALL.D.Tabela
      , !ALL.D.Plano
      , !ALL.D.Regional
      , 'Cotas Vendidas'
    )
  
    *
  
    DB('REC.130.Mix_Prazo'
      , SUBST( !ALL.D.Periodo_Projecao, 5, 10 )
      , SUBST( !ALL.D.Periodo_Projecao, 1, 3 )
      , !ALL.D.Versao
      , !ALL.D.Canal
      , !ALL.D.Especie
      , !ALL.D.Tabela
      , !ALL.D.Plano
      , !ALL.D.Prazo
      , 'Distribuicao por Prazo'
    )
  , 0
);

# --------------------------------------------------------------------------------------------
# Name: Flag Inicial
# Desc: Flag
# Date: 15/09/2026
# Author: Gregorie Amaral
# --------------------------------------------------------------------------------------------
['REC.M.170.Estoque_Cotas_CN':'REC.M.170.Estoque_Cotas_CN':'Flag', 'REC.D.Safra_CN':'REC.D.Safra_CN':'001'] = N:
  IF( DB( 'PRE.100.Premissas_Gerais'
          , SUBST( !ALL.D.Periodo_Projecao, 5, 10 )
          , SUBST( !ALL.D.Periodo_Projecao, 1, 3 )
          , !ALL.D.Versao,'Periodo Inicial da Projecao' ) = 1 
      &
 ['Cotas Vendidas na Safra'] <> 0 
  # ['REC.M.170.Estoque_Cotas_CN':'REC.M.170.Estoque_Cotas_CN':'Cotas Valor'] <> 0 
  # % 
  # ['REC.M.170.Estoque_Cotas_CN':'REC.M.170.Estoque_Cotas_CN':'Cotas Input'] <> 0
  , NUMBR( !ALL.D.Prazo ) + 1
  , CONTINUE );


# --------------------------------------------------------------------------------------------
# Name: Flag
# Desc: Distribui as safras ao longo dos períodos
# Date: 18/09/2026
# Author: Gregorie Amaral
# --------------------------------------------------------------------------------------------
['REC.M.170.Estoque_Cotas_CN':'REC.M.170.Estoque_Cotas_CN':'Flag','ALL.D.Prazo':'12','REC.D.Safra_CN':{'001','002','003'}] = N:
# ['REC.M.170.Estoque_Cotas_CN':'REC.M.170.Estoque_Cotas_CN':'Flag'] = N:
IF(
DB(
   'REC.170.Estoque_Cotas_CN'
   , !ALL.D.Versao
   , ATTRS('REC.D.Safra_CN', !REC.D.Safra_CN, 'Safra Anterior')
   , ATTRS('ALL.D.Periodo_Projecao', !ALL.D.Periodo_Projecao, 'Previous Period')
   , !ALL.D.Canal
   , !ALL.D.Especie
   , !ALL.D.Tabela
   , !ALL.D.Plano
   , !ALL.D.Prazo
   , !ALL.D.Regional
   , 'Flag'
) =  NUMBR( !ALL.D.Prazo ) + 1
        &
  ['Cotas Vendidas na Safra'] <> 0
, NUMBR( !ALL.D.Prazo ) + 1
, CONTINUE
);

['REC.M.170.Estoque_Cotas_CN':'REC.M.170.Estoque_Cotas_CN':'Flag','ALL.D.Prazo':'12','REC.D.Safra_CN':{'001','002','003'}] = N:
# ['REC.M.170.Estoque_Cotas_CN':'REC.M.170.Estoque_Cotas_CN':'Flag'] = N:
If(
    DB( 'REC.170.Estoque_Cotas_CN'
        , !ALL.D.Versao
        , !REC.D.Safra_CN
        , DB( 'SYS.200.Time_Travel'
               , SUBST( !ALL.D.Periodo_Projecao, 5, 4 )
               , SUBST( !ALL.D.Periodo_Projecao, 1, 3 )
               , '-1', 'Mes' ) |'/'| DB( 'SYS.200.Time_Travel'
                                        , SUBST( !ALL.D.Periodo_Projecao, 5, 4 )
                                        , SUBST( !ALL.D.Periodo_Projecao, 1, 3 )
                                        , '-1', 'Ano' )
        , !ALL.D.Canal
        , !ALL.D.Especie
        , !ALL.D.Tabela
        , !ALL.D.Plano
        , !ALL.D.Prazo
        , !ALL.D.Regional
        , !REC.M.170.Estoque_Cotas_CN ) <>0
  ,    
  DB( 'REC.170.Estoque_Cotas_CN'
        , !ALL.D.Versao
        , !REC.D.Safra_CN
               , DB( 'SYS.200.Time_Travel'
               , SUBST( !ALL.D.Periodo_Projecao, 5, 4 )
               , SUBST( !ALL.D.Periodo_Projecao, 1, 3 )
               , '-1', 'Mes' ) |'/'| DB( 'SYS.200.Time_Travel'
                                        , SUBST( !ALL.D.Periodo_Projecao, 5, 4 )
                                        , SUBST( !ALL.D.Periodo_Projecao, 1, 3 )
                                        , '-1', 'Ano' )
        , !ALL.D.Canal
        , !ALL.D.Especie
        , !ALL.D.Tabela
        , !ALL.D.Plano
        , !ALL.D.Prazo
        , !ALL.D.Regional
        , !REC.M.170.Estoque_Cotas_CN ) -1
  ,CONTINUE
   );

# ['REC.M.170.Estoque_Cotas_CN':'REC.M.170.Estoque_Cotas_CN':'Flag','ALL.D.Prazo':'ALL.D.Prazo':'12','REC.D.Safra_CN':{'001','002','003'}] = N:
