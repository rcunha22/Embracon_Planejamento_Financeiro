# --------------------------------------------------------------------------------------------
# Name: Cotas Valor
# Desc: Calcula as cotas vendidas apenas para o período correspondente à safra
# Date: 21/09/2026
# Author: Gregorie Amaral
# --------------------------------------------------------------------------------------------

['REC.M.170.Estoque_Cotas_CN':'REC.M.170.Estoque_Cotas_CN':'Cotas Valor'] = N:
# IF(!REC.D.Safra_CN @= !ALL.D.Periodo_Projecao_2,
# IF(['REC.M.170.Estoque_Cotas_CN':'REC.M.170.Estoque_Cotas_CN':'Flag Aux'] = 1,
IF( DB( 'SYS.310.Safra_Control'
        , !ALL.D.Versao
        , !REC.D.Safra_CN
        , !ALL.D.Prazo
        , !ALL.D.Periodo_Projecao_2
        , 'Flag Aux' ) = 1,

  DB('REC.140.Vendas_Projecao'
      , SUBST( ATTRS( 'ALL.D.Periodo_Projecao_2', !ALL.D.Periodo_Projecao_2, !ALL.D.Versao ), 5, 10 ) 
      , SUBST( ATTRS( 'ALL.D.Periodo_Projecao_2', !ALL.D.Periodo_Projecao_2, !ALL.D.Versao ), 1, 3 ) 
      , !ALL.D.Versao
      , !ALL.D.Canal
      , !ALL.D.Especie
      , !ALL.D.Tabela
      , !ALL.D.Plano
      , !ALL.D.Regional
      , 'Cotas Vendidas'
    )
  
    *
  
    DB('REC.130.Mix_Prazo'
      , SUBST( ATTRS( 'ALL.D.Periodo_Projecao_2', !ALL.D.Periodo_Projecao_2, !ALL.D.Versao ), 5, 10 ) 
      , SUBST( ATTRS( 'ALL.D.Periodo_Projecao_2', !ALL.D.Periodo_Projecao_2, !ALL.D.Versao ), 1, 3 ) 
      , !ALL.D.Versao
      , !ALL.D.Canal
      , !ALL.D.Especie
      , !ALL.D.Tabela
      , !ALL.D.Plano
      , !ALL.D.Prazo
      , 'Distribuicao por Prazo'
    ), 0

);

