# --------------------------------------------------------------------------------------------
# Name: Cotas Canceladas
# Desc: Calcula a quantidade de cotas canceladas.
#        No período de nascimento da safra não há cancelamento.
# Date: 21/09/2026
# Author: Gregorie Amaral
# --------------------------------------------------------------------------------------------

['REC.M.170.Estoque_Cotas_CN':'REC.M.170.Estoque_Cotas_CN':'Cotas Canceladas'] = N:

IF(DB( 'SYS.310.Safra_Control'
        , !ALL.D.Versao
        , !REC.D.Safra_CN
        , !ALL.D.Prazo
        , !ALL.D.Periodo_Projecao_2
        , 'Flag Aux' ) = 1
# IF(['REC.M.170.Estoque_Cotas_CN':'REC.M.170.Estoque_Cotas_CN':'Flag Aux'] = 1

, 0

,  IF( DB( 'SYS.310.Safra_Control'
        , !ALL.D.Versao
        , !REC.D.Safra_CN
        , !ALL.D.Prazo
        , !ALL.D.Periodo_Projecao_2
        , 'Flag' ) <> 0

  # ,  IF( DB( 'REC.170.Estoque_Cotas_CN_v2'
  #           , !ALL.D.Versao
  #           , !REC.D.Safra_CN
  #           , !ALL.D.Periodo_Projecao_2
  #           , !ALL.D.Canal
  #           , !ALL.D.Especie
  #           , !ALL.D.Tabela
  #           , !ALL.D.Plano
  #           , !ALL.D.Prazo
  #           , !ALL.D.Regional
  #           , 'Flag' ) <> 0
  
  , ['REC.M.170.Estoque_Cotas_CN':'REC.M.170.Estoque_Cotas_CN':'Saldo Inicial Nao Contempladas']
  
   *
  
   DB('REC.150.Premissas_Cancelamento_CN'
      , !ALL.D.Versao
      , !ALL.D.Canal
      , !ALL.D.Especie
      , !ALL.D.Tabela
      , STR(NUMBR(!ALL.D.Prazo) - DB( 'SYS.310.Safra_Control'
        , !ALL.D.Versao
        , !REC.D.Safra_CN
        , !ALL.D.Prazo
        , !ALL.D.Periodo_Projecao_2
        , 'Flag' ) + 2,2,0)
      , 'Cancelamento'
   )
   *
   DB('REC.150.Premissas_Cancelamento_CN'
      , !ALL.D.Versao
      , !ALL.D.Canal
      , !ALL.D.Especie
      , !ALL.D.Tabela
      , STR(NUMBR(!ALL.D.Prazo) - DB( 'SYS.310.Safra_Control'
        , !ALL.D.Versao
        , !REC.D.Safra_CN
        , !ALL.D.Prazo
        , !ALL.D.Periodo_Projecao_2
        , 'Flag' ) + 2,2,0)
      , 'Curva de Cancelamento'
   )
  , 0)

);

