# --------------------------------------------------------------------------------------------
# Name: Saldo Final Nao Contempladas
# Desc: Calcula o saldo final de cotas não contempladas deduzindo do saldo inicial as saídas ocorridas no período
# Date: 15/09/2026
# Author: Gregorie Amaral
# --------------------------------------------------------------------------------------------

['REC.M.170.Estoque_Cotas_CN':'REC.M.170.Estoque_Cotas_CN':'Saldo Final Nao Contempladas'] = N:
  
  IF(NUMBR(!REC.D.Safra_CN ) <= NUMBR(!ALL.D.Prazo), 
  
  ['REC.M.170.Estoque_Cotas_CN':'Saldo Inicial Nao Contempladas'] - 
  ['REC.M.170.Estoque_Cotas_CN':'REC.M.170.Estoque_Cotas_CN':'Contemplacoes por Sorteio'] - 
  ['REC.M.170.Estoque_Cotas_CN':'REC.M.170.Estoque_Cotas_CN':'Contemplacoes por Lance'] -
  ['REC.M.170.Estoque_Cotas_CN':'REC.M.170.Estoque_Cotas_CN':'Cotas Canceladas'] - 
  ['REC.M.170.Estoque_Cotas_CN':'REC.M.170.Estoque_Cotas_CN':'Cotas Quitadas Não Contempladas']
  , 
0
);

#EndRegion - Não Contempladas

#Region - Contempladas

# --------------------------------------------------------------------------------------------
# Name: Contempladas do Periodo
# Desc: Calcula a quantidade de cotas contempladas no período somando as contemplações por sorteio e as contemplações por lance.
# Date: 15/09/2026
# Author: Gregorie Amaral
# --------------------------------------------------------------------------------------------

['REC.M.170.Estoque_Cotas_CN':'REC.M.170.Estoque_Cotas_CN':'Contempladas do Periodo'] = N:
  ['REC.M.170.Estoque_Cotas_CN':'REC.M.170.Estoque_Cotas_CN':'Contemplacoes por Sorteio'] + 
  ['REC.M.170.Estoque_Cotas_CN':'REC.M.170.Estoque_Cotas_CN':'Contemplacoes por Lance'];

# --------------------------------------------------------------------------------------------
# Name: Saldo Final Contempladas
# Desc: Calcula o saldo final de cotas contempladas adicionando ao saldo inicial as contemplações ocorridas no período e subtraindo as cotas quitadas.
# Date: 15/09/2026
# Author: Gregorie Amaral
# --------------------------------------------------------------------------------------------

 ['REC.M.170.Estoque_Cotas_CN':'REC.M.170.Estoque_Cotas_CN':'Saldo Final Contempladas'] = N:
     IF(NUMBR(!REC.D.Safra_CN ) <= NUMBR(!ALL.D.Prazo), 
   
['REC.M.170.Estoque_Cotas_CN':'REC.M.170.Estoque_Cotas_CN':'Saldo Inicial Contempladas'] +
['REC.M.170.Estoque_Cotas_CN':'REC.M.170.Estoque_Cotas_CN':'Contempladas do Periodo'] -
['REC.M.170.Estoque_Cotas_CN':'REC.M.170.Estoque_Cotas_CN':'Cotas Quitadas Contempladas']
  ,
0
);

# --------------------------------------------------------------------------------------------
# Name: Saldo Inicial Contempladas
# Desc: Calcula o saldo inicial de cotas contempladas por safra. Para a primeira safra, o saldo inicial é zero. Para as demais safras, considera o saldo final de contempladas da safra anterior.
# Date: 15/09/2026
# Author: Gregorie Amaral
# --------------------------------------------------------------------------------------------

['REC.M.170.Estoque_Cotas_CN':'REC.M.170.Estoque_Cotas_CN':'Saldo Inicial Contempladas'] = N:
IF( DB( 'SYS.310.Safra_Control'
        , !ALL.D.Versao
        , !REC.D.Safra_CN
        , !ALL.D.Prazo
        , !ALL.D.Periodo_Projecao_2
        , 'Flag Aux' ) = 1
  , 0
  
,  IF( DB( 'SYS.310.Safra_Control'
        , !ALL.D.Versao
        , !REC.D.Safra_CN
        , !ALL.D.Prazo
        , !ALL.D.Periodo_Projecao_2
        , 'Flag' ) <> 0
  ,DB( 'REC.170.Estoque_Cotas_CN_v2'
      , !ALL.D.Versao
      , !REC.D.Safra_CN
      , ATTRS( 'ALL.D.Periodo_Projecao_2', !ALL.D.Periodo_Projecao_2, 'Período Anterior' )
      , !ALL.D.Canal
      , !ALL.D.Especie
      , !ALL.D.Tabela
      , !ALL.D.Plano
      , !ALL.D.Prazo
      , !ALL.D.Regional
      , 'Saldo Final Contempladas')
  ,0)
  );

# ['REC.M.170.Estoque_Cotas_CN':'REC.M.170.Estoque_Cotas_CN':'Saldo Inicial Contempladas'] = N:
# IF( ['REC.M.170.Estoque_Cotas_CN':'REC.M.170.Estoque_Cotas_CN':'Flag Aux'] = 1
#   , 0
  
# ,  IF( ['REC.M.170.Estoque_Cotas_CN':'REC.M.170.Estoque_Cotas_CN':'Flag'] <> 0
#   ,DB( 'REC.170.Estoque_Cotas_CN_v2'
#       , !ALL.D.Versao
#       , !REC.D.Safra_CN
#       , ATTRS( 'ALL.D.Periodo_Projecao_2', !ALL.D.Periodo_Projecao_2, 'Período Anterior' )
#       , !ALL.D.Canal
#       , !ALL.D.Especie
#       , !ALL.D.Tabela
#       , !ALL.D.Plano
#       , !ALL.D.Prazo
#       , !ALL.D.Regional
#       , 'Saldo Final Contempladas')
#   ,0)
#   );

# --------------------------------------------------------------------------------------------
# Name: Cotas Quitadas Contempladas
# Desc: Calcula a quantidade de cotas contempladas quitadas antecipadamente aplicando o percentual de quitação antecipada, definido nas Premissas de Assembleia, sobre o saldo inicial de contempladas.
# Date: 15/09/2026
# Author: Gregorie Amaral
# --------------------------------------------------------------------------------------------

['REC.M.170.Estoque_Cotas_CN':'REC.M.170.Estoque_Cotas_CN':'Cotas Quitadas Contempladas'] = N:
  ['REC.M.170.Estoque_Cotas_CN':'REC.M.170.Estoque_Cotas_CN':'Saldo Inicial Contempladas'] *
    DB( 'REC.160.Premissas_Assembleia_CN'
      , !ALL.D.Versao
      , !ALL.D.Canal
      , !ALL.D.Especie
      , !ALL.D.Tabela
      , !ALL.D.Plano
      , STR(NUMBR(!ALL.D.Prazo) -DB( 'SYS.310.Safra_Control'
        , !ALL.D.Versao
        , !REC.D.Safra_CN
        , !ALL.D.Prazo
        , !ALL.D.Periodo_Projecao_2
        , 'Flag' ) + 2,2,0)
      , 'Quitacao Antecipada' );

# ['REC.M.170.Estoque_Cotas_CN':'REC.M.170.Estoque_Cotas_CN':'Cotas Quitadas Contempladas'] = N:
#   ['REC.M.170.Estoque_Cotas_CN':'REC.M.170.Estoque_Cotas_CN':'Saldo Inicial Contempladas'] *
#     DB( 'REC.160.Premissas_Assembleia_CN'
#       , !ALL.D.Versao
#       , !ALL.D.Canal
#       , !ALL.D.Especie
#       , !ALL.D.Tabela
#       , !ALL.D.Plano
#       , STR(NUMBR(!ALL.D.Prazo) - DB('REC.170.Estoque_Cotas_CN_v2'
#           , !ALL.D.Versao
#           , !REC.D.Safra_CN
#           , !ALL.D.Periodo_Projecao_2
#           , !ALL.D.Canal
#           , !ALL.D.Especie
#           , !ALL.D.Tabela
#           , !ALL.D.Plano
#           , !ALL.D.Prazo
#           , !ALL.D.Regional
#           , 'Flag') + 2,2,0)
#       , 'Quitacao Antecipada' );


#EndRegion - Contempladas

FEEDERS;

