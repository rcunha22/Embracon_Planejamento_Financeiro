# --------------------------------------------------------------------------------------------
# Name: Nascimento da Safra
# Desc: Alimenta o início da cadeia de cálculo das safras a partir das cotas vendidas.
# Date: 21/09/2026
# Author: Gregorie Amaral
# --------------------------------------------------------------------------------------------
  
['REC.M.170.Estoque_Cotas_CN':'Cotas Vendidas na Safra','ALL.D.Versao':'ALL.D.Versao':'Dynamic Versions'] =>
['REC.M.170.Estoque_Cotas_CN':'Saldo Inicial Nao Contempladas'];

# --------------------------------------------------------------------------------------------
# Name: Nao Contempladas
# Desc: Alimenta todos os cálculos derivados do saldo inicial de não contempladas.
# Date: 21/09/2026
# Author: Gregorie Amaral
# --------------------------------------------------------------------------------------------

['REC.M.170.Estoque_Cotas_CN':'Saldo Inicial Nao Contempladas','ALL.D.Versao':'ALL.D.Versao':'Dynamic Versions'] =>

 ['REC.M.170.Estoque_Cotas_CN':'Contemplacoes por Sorteio']
, ['REC.M.170.Estoque_Cotas_CN':'Contemplacoes por Lance']
, ['REC.M.170.Estoque_Cotas_CN':'Cotas Canceladas']
, ['REC.M.170.Estoque_Cotas_CN':'Cotas Quitadas Nao Contempladas']
, ['REC.M.170.Estoque_Cotas_CN':'Saldo Final Nao Contempladas'];

# --------------------------------------------------------------------------------------------
# Name: Contempladas do Periodo
# Desc: Alimenta a métrica consolidada de contemplações do período.
# Date: 21/09/2026
# Author: Gregorie Amaral
# --------------------------------------------------------------------------------------------

['REC.M.170.Estoque_Cotas_CN':'Contemplacoes por Sorteio','ALL.D.Versao':'ALL.D.Versao':'Dynamic Versions'] =>
['REC.M.170.Estoque_Cotas_CN':'Contempladas do Periodo'];

['REC.M.170.Estoque_Cotas_CN':'Contemplacoes por Lance','ALL.D.Versao':'ALL.D.Versao':'Dynamic Versions'] =>
['REC.M.170.Estoque_Cotas_CN':'Contempladas do Periodo'];

# --------------------------------------------------------------------------------------------
# Name: Saldo Final Contempladas
# Desc: Alimenta o saldo final de contempladas a partir das movimentações do período.
# Date: 21/09/2026
# Author: Gregorie Amaral
# --------------------------------------------------------------------------------------------

['REC.M.170.Estoque_Cotas_CN':'Contempladas do Periodo','ALL.D.Versao':'ALL.D.Versao':'Dynamic Versions'] =>
['REC.M.170.Estoque_Cotas_CN':'Saldo Final Contempladas'];

# --------------------------------------------------------------------------------------------
# Name: Saldo Inicial Contempladas
# Desc: Alimenta o saldo inicial de contempladas a partir das movimentações do período.
# Date: 21/09/2026
# Author: Gregorie Amaral
# --------------------------------------------------------------------------------------------

['REC.M.170.Estoque_Cotas_CN':'REC.M.170.Estoque_Cotas_CN':'Saldo Final Contempladas','ALL.D.Versao':'ALL.D.Versao':'Dynamic Versions'] =>
DB( 'REC.170.Estoque_Cotas_CN_v2'
      , !ALL.D.Versao
      , !REC.D.Safra_CN
      , ATTRS( 'ALL.D.Periodo_Projecao_2', !ALL.D.Periodo_Projecao_2, 'Período Posterior' )
      , !ALL.D.Canal
      , !ALL.D.Especie
      , !ALL.D.Tabela
      , !ALL.D.Plano
      , !ALL.D.Prazo
      , !ALL.D.Regional
      , 'Saldo Inicial Contempladas')
  ;

# --------------------------------------------------------------------------------------------
# Name: Saldo Inicial Não Contempladas
# Desc: Alimenta o saldo inicial de  não contempladas a partir das movimentações do período.
# Date: 21/09/2026
# Author: Gregorie Amaral
# --------------------------------------------------------------------------------------------

['REC.M.170.Estoque_Cotas_CN':'REC.M.170.Estoque_Cotas_CN':'Saldo Final Nao Contempladas','ALL.D.Versao':'ALL.D.Versao':'Dynamic Versions'] =>
DB( 'REC.170.Estoque_Cotas_CN_v2'
      , !ALL.D.Versao
      , !REC.D.Safra_CN
      , ATTRS( 'ALL.D.Periodo_Projecao_2', !ALL.D.Periodo_Projecao_2, 'Período Posterior' )
      , !ALL.D.Canal
      , !ALL.D.Especie
      , !ALL.D.Tabela
      , !ALL.D.Plano
      , !ALL.D.Prazo
      , !ALL.D.Regional
      , 'Saldo Inicial Nao Contempladas')
  ;


# --------------------------------------------------------------------------------------------
# Name: Contempladas
# Desc: Alimenta os cálculos derivados do saldo inicial de contempladas.
# Date: 21/09/2026
# Author: Gregorie Amaral
# --------------------------------------------------------------------------------------------

['REC.M.170.Estoque_Cotas_CN':'Saldo Inicial Contempladas','ALL.D.Versao':'ALL.D.Versao':'Dynamic Versions'] =>

 ['REC.M.170.Estoque_Cotas_CN':'Cotas Quitadas Contempladas']
, ['REC.M.170.Estoque_Cotas_CN':'Saldo Final Contempladas'];

  # # --------------------------------------------------------------------------------------------

['REC.M.170.Estoque_Cotas_CN':'Cotas Valor', 'ALL.D.Versao':'ALL.D.Versao':'Dynamic Versions'] =>
  DB( 'REC.190.Receitas_CN'
    , !ALL.D.Versao, !REC.D.Safra_CN, !ALL.D.Periodo_Projecao_2, !ALL.D.Canal, !ALL.D.Especie
    , !ALL.D.Tabela, !ALL.D.Plano, !ALL.D.Prazo, !ALL.D.Regional
    , 'Estoque Inicial Taxa no Prazo' )
  ,
  DB( 'REC.190.Receitas_CN'
    , !ALL.D.Versao, !REC.D.Safra_CN, !ALL.D.Periodo_Projecao_2, !ALL.D.Canal, !ALL.D.Especie
    , !ALL.D.Tabela, !ALL.D.Plano, !ALL.D.Prazo, !ALL.D.Regional
    , 'Estoque Inicial Taxa Embutida' )
  ,
  DB( 'REC.190.Receitas_CN'
    , !ALL.D.Versao, !REC.D.Safra_CN, !ALL.D.Periodo_Projecao_2, !ALL.D.Canal, !ALL.D.Especie
    , !ALL.D.Tabela, !ALL.D.Plano, !ALL.D.Prazo, !ALL.D.Regional
    , 'Estoque Inicial Taxa Antecipada Acrescida' );

['REC.M.170.Estoque_Cotas_CN':'Saldo Final de Cotas', 'ALL.D.Versao':'ALL.D.Versao':'Dynamic Versions'] =>
  DB( 'REC.190.Receitas_CN'
    , !ALL.D.Versao, !REC.D.Safra_CN, !ALL.D.Periodo_Projecao_2, !ALL.D.Canal, !ALL.D.Especie
    , !ALL.D.Tabela, !ALL.D.Plano, !ALL.D.Prazo, !ALL.D.Regional
    , 'Fundo de Reserva' );

