#Region - Não Contempladas

# --------------------------------------------------------------------------------------------
# Name: Saldo Inicial Nao Contempladas
# Desc: Quando inicia a safra utiliza as cotas vendidas. Nos demais períodos utiliza o saldo final do período anterior.
# Date: 21/09/2026
# Author: Gregorie Amaral
# --------------------------------------------------------------------------------------------

['REC.M.170.Estoque_Cotas_CN':'REC.M.170.Estoque_Cotas_CN':'Saldo Inicial Nao Contempladas'] = N:
# IF(['REC.M.170.Estoque_Cotas_CN':'REC.M.170.Estoque_Cotas_CN':'Flag Aux'] = 1
  IF(DB( 'SYS.310.Safra_Control'
        , !ALL.D.Versao
        , !REC.D.Safra_CN
        , !ALL.D.Prazo
        , !ALL.D.Periodo_Projecao_2
          , 'Flag Aux' ) = 1,
  
  ['REC.M.170.Estoque_Cotas_CN':'REC.M.170.Estoque_Cotas_CN':'Cotas Vendidas na Safra']
# , IF( ['REC.M.170.Estoque_Cotas_CN':'REC.M.170.Estoque_Cotas_CN':'Flag'] <> 0
, IF(DB( 'SYS.310.Safra_Control'
        , !ALL.D.Versao
        , !REC.D.Safra_CN
        , !ALL.D.Prazo
        , !ALL.D.Periodo_Projecao_2
        , 'Flag' ) <> 0
  , DB('REC.170.Estoque_Cotas_CN_v2'
        , !ALL.D.Versao
        , !REC.D.Safra_CN
        , ATTRS( 'ALL.D.Periodo_Projecao_2', !ALL.D.Periodo_Projecao_2, 'Período Anterior' )
        , !ALL.D.Canal
        , !ALL.D.Especie
        , !ALL.D.Tabela
        , !ALL.D.Plano
        , !ALL.D.Prazo
        , !ALL.D.Regional
        , 'Saldo Final Nao Contempladas'
     )
  ,0)
);

# --------------------------------------------------------------------------------------------
# Name: Contemplacoes por Sorteio
# Desc: Calcula a quantidade de cotas contempladas por sorteio aplicando o percentual de contemplação por sorteio.
#        No período de nascimento da safra não há contemplação.
# Date: 21/09/2026
# Author: Gregorie Amaral
# --------------------------------------------------------------------------------------------

['REC.M.170.Estoque_Cotas_CN':'REC.M.170.Estoque_Cotas_CN':'Contemplacoes por Sorteio'] = N:
# IF(['REC.M.170.Estoque_Cotas_CN':'REC.M.170.Estoque_Cotas_CN':'Flag Aux'] = 1

  IF(DB( 'SYS.310.Safra_Control'
        , !ALL.D.Versao
        , !REC.D.Safra_CN
        , !ALL.D.Prazo
        , !ALL.D.Periodo_Projecao_2
        , 'Flag Aux' ) = 1
  
, 0

# ,   IF( DB( 'REC.170.Estoque_Cotas_CN_v2'
#             , !ALL.D.Versao
#             , !REC.D.Safra_CN
#             , !ALL.D.Periodo_Projecao_2
#             , !ALL.D.Canal
#             , !ALL.D.Especie
#             , !ALL.D.Tabela
#             , !ALL.D.Plano
#             , !ALL.D.Prazo
#             , !ALL.D.Regional
#             , 'Flag' ) <> 0,

  ,   IF( DB( 'SYS.310.Safra_Control'
        , !ALL.D.Versao
        , !REC.D.Safra_CN
        , !ALL.D.Prazo
        , !ALL.D.Periodo_Projecao_2
        , 'Flag' ) <> 0,
  
  ['REC.M.170.Estoque_Cotas_CN':'REC.M.170.Estoque_Cotas_CN':'Saldo Inicial Nao Contempladas']
   *

     DB('REC.160.Premissas_Assembleia_CN'
      , !ALL.D.Versao
      , !ALL.D.Canal
      , !ALL.D.Especie
      , !ALL.D.Tabela
      , !ALL.D.Plano
      , STR(NUMBR(!ALL.D.Prazo) - DB( 'SYS.310.Safra_Control'
        , !ALL.D.Versao
        , !REC.D.Safra_CN
        , !ALL.D.Prazo
        , !ALL.D.Periodo_Projecao_2
        , 'Flag' ) + 2,2,0)
      , 'Contemplacao por Sorteio')
  , 0)
);

