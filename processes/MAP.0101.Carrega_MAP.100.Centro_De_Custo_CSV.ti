    CellPutS( vCodigo_Nivel_05,               cCuboReject, cProcesso, cUsuario, sLinha, 'COL20' );
    CellPutS( vDescricao_Nivel_05,            cCuboReject, cProcesso, cUsuario, sLinha, 'COL21' );
    CellPutS( vCodigo_Nivel_06,               cCuboReject, cProcesso, cUsuario, sLinha, 'COL22' );
