    AttrPutS( 'Flag Ativo',                   'SYS.M.160.Rejeitados_Cargas', 'COL33', cProcesso );
    AttrPutS( 'Data de Atualização',          'SYS.M.160.Rejeitados_Cargas', 'COL34', cProcesso );

    cExisteCabecalhoRejeitado = 1;
    cTipoErro = 2;
    If( cUtilizarDebug @= 'S'  );
      cMensagemProcesso = ' Processo concluido com registros salvos no cubo de Debug, verificar o cubo:    ' | cCuboReject;
    EndIf;
  EndIf;


  # Escreve o registro no arquivo de debug ou rejeitados
  # =================================================================================
  #AsciiOutput( cNomeArquivoRejeitadoCompleto , vElement , vDesc_Element , vCod_N1 , vDesc_N1 , vCod_N2 , vDesc_N2 , sContadorRegistro , cMensagemRegistro );
  
    cContadorRejeitados = cContadorRejeitados + 1;
    sLinha = 'L'|NumberToString( cContadorRejeitados );
    CellPutS( sContadorRegistro, cCuboReject, cProcesso, cUsuario, sLinha, 'Linha de Registro' );
    CellPutS( cMensagemRegistro, cCuboReject, cProcesso, cUsuario, sLinha, 'Mensagem' );
    CellPutS( vCodigo_Centro_de_Custo,        cCuboReject, cProcesso, cUsuario, sLinha, 'COL1'  );
