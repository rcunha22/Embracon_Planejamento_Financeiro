    CellPutS( vFlag_Ativo,                    cCuboReject, cProcesso, cUsuario, sLinha, 'COL33' );
    CellPutS( vData_de_Atualizacao,           cCuboReject, cProcesso, cUsuario, sLinha, 'COL34' );


  # Limpa as variaveis e pula o registro
  # ============================
  IF( cExisteRegistroRejeitado = 1 );
     cExisteRegistroRejeitado = 0;
     cMensagemRegistro = '';
     cMensagemProcesso = ' Processo concluido com registros rejeitados, verificar o cubo:    ' | cCuboReject;
     ItemSkip;
  EndIf;

