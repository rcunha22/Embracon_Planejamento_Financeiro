# ===================================================================================
# Grava os dados no cubo
# ===================================================================================
s01 = vDescricao_Centro_de_Custo;
s02 = vCodigo_Classificacao_Origem;
s03 = vDescricao_Classificacao_Origem;
s04 = vCodigo_Classificacao_Ajuste;
