    CellPutS( vCodigo_Nivel_03,               cCuboReject, cProcesso, cUsuario, sLinha, 'COL16' );
    CellPutS( vDescricao_Nivel_03,            cCuboReject, cProcesso, cUsuario, sLinha, 'COL17' );
    CellPutS( vCodigo_Nivel_04,               cCuboReject, cProcesso, cUsuario, sLinha, 'COL18' );
