s30 = vDescricao_Nivel_10;
s31 = vFlag_Gesto_Ativa;
s32 = vFlag_Ativo;
s33 = vData_de_Atualizacao;

sCC = Fill( '0', 10 - Long( Trim( vCodigo_Centro_de_Custo ) ) ) | Trim( vCodigo_Centro_de_Custo );

CellPutS( s01, cCuboDestino, pVersao, sCC, 'Descrição Centro de Custo' );
CellPutS( s02, cCuboDestino, pVersao, sCC, 'Código Classificação Origem' );
CellPutS( s03, cCuboDestino, pVersao, sCC, 'Descrição Classificação Origem' );
CellPutS( s04, cCuboDestino, pVersao, sCC, 'Código Classificação Ajuste' );
CellPutS( s05, cCuboDestino, pVersao, sCC, 'Descrição Classificação Ajuste' );
CellPutS( s06, cCuboDestino, pVersao, sCC, 'Classificação Utilizada' );
CellPutS( s07, cCuboDestino, pVersao, sCC, 'Código Revenda' );
CellPutS( s08, cCuboDestino, pVersao, sCC, 'Código Filial Origem' );
CellPutS( s09, cCuboDestino, pVersao, sCC, 'Código Filial Ajuste' );
CellPutS( s10, cCuboDestino, pVersao, sCC, 'Código Filial Utilizado' );
CellPutS( s11, cCuboDestino, pVersao, sCC, 'Código Nível 01' );
CellPutS( s12, cCuboDestino, pVersao, sCC, 'Descrição Nível 01' );
CellPutS( s13, cCuboDestino, pVersao, sCC, 'Código Nível 02' );
CellPutS( s14, cCuboDestino, pVersao, sCC, 'Descrição Nível 02' );
CellPutS( s15, cCuboDestino, pVersao, sCC, 'Código Nível 03' );
CellPutS( s16, cCuboDestino, pVersao, sCC, 'Descrição Nível 03' );
CellPutS( s17, cCuboDestino, pVersao, sCC, 'Código Nível 04' );
CellPutS( s18, cCuboDestino, pVersao, sCC, 'Descrição Nível 04' );
CellPutS( s19, cCuboDestino, pVersao, sCC, 'Código Nível 05' );
CellPutS( s20, cCuboDestino, pVersao, sCC, 'Descrição Nível 05' );
CellPutS( s21, cCuboDestino, pVersao, sCC, 'Código Nível 06' );
CellPutS( s22, cCuboDestino, pVersao, sCC, 'Descrição Nível 06' );
CellPutS( s23, cCuboDestino, pVersao, sCC, 'Código Nível 07' );
CellPutS( s24, cCuboDestino, pVersao, sCC, 'Descrição Nível 07' );
CellPutS( s25, cCuboDestino, pVersao, sCC, 'Código Nível 08' );
CellPutS( s26, cCuboDestino, pVersao, sCC, 'Descrição Nível 08' );
CellPutS( s27, cCuboDestino, pVersao, sCC, 'Código Nível 09' );
CellPutS( s28, cCuboDestino, pVersao, sCC, 'Descrição Nível 09' );
CellPutS( s29, cCuboDestino, pVersao, sCC, 'Código Nível 10' );
CellPutS( s30, cCuboDestino, pVersao, sCC, 'Descrição Nível 10' );
CellPutS( s31, cCuboDestino, pVersao, sCC, 'Flag Gestão Ativa' );
CellPutS( s32, cCuboDestino, pVersao, sCC, 'Flag Ativo' );
CellPutS( s33, cCuboDestino, pVersao, sCC, 'Data de Atualização' );

#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****


# ===============================================================================================================
#EPILOGCOMMENT        Descrição:  Habilita log do cubo de destino, realiza CubeSaveData e registra log de status do processo.
# ===============================================================================================================

# =================================================================================
# Habilita o Log e salva dados no cubo
# =================================================================================
CellPutS ( 'YES', cCuboPropriedade, cCuboDestino, 'LOGGING' );
CubeSaveData ( cCuboDestino );


# =================================================================================
# Registra o Log de Erro ou Sucesso no Cubo de Controle
# =================================================================================
If( cTipoErro = 0 );
   cMensagemProcesso  = ' Processo concluído com sucesso';
EndIf;


s01	= TimSt( cHorarioInicio , '\Y-\m-\d \hh\im\ss' );
s02 	= cUsuario ;
s03 	= cMensagemProcesso ;
s04 	= sContadorRegistro  ;
s05 	= TimSt( Now - cHorarioInicio, ' \h:\i:\s') ;

CellPutS( s01 , cCuboParametro, cProcesso, 'DataHora Fim' );
CellPutS( s02 , cCuboParametro, cProcesso, 'Usuário' );
CellPutS( s03 , cCuboParametro, cProcesso, 'Mensagem de Log' );
CellPutS( s04 , cCuboParametro, cProcesso, 'Registros Processados' );
CellPutS( s05 , cCuboParametro, cProcesso, 'Tempo de Execução' );


If( cTipoErro = 2 );
  ItemReject( cMensagemProcesso );
EndIf;
#endregion