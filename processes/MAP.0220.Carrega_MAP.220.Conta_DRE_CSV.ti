# ===================================================================================
# DEBUG ou REJEIÇÃO
# Registra em arquivo os registros
# ===================================================================================
If( cExisteRegistroRejeitado = 1  %  cUtilizarDebug @= 'S' );


  # Escreve o cabeçalho do arquivo de registros rejeitados
  # =================================================================================
  If( cExisteCabecalhoRejeitado = 0);
    #AsciiOutput( cNomeArquivoRejeitadoCompleto , 'Cod. Conta' , 'Desc. Conta' , 'Cod. N1' , 'Desc. N1' , 'Cod N2' , 'Desc. N2' , 'Num. Registro' , 'Mensagem de Erro');
    AttrPutS( 'Num. Registro', 'SYS.M.160.Rejeitados_Cargas', 'Linha de Registro', cProcesso );
    AttrPutS( 'Mensagem de Erro', 'SYS.M.160.Rejeitados_Cargas', 'Mensagem', cProcesso );
    AttrPutS( 'Código Linha DRE',         'SYS.M.160.Rejeitados_Cargas', 'COL1',  cProcesso );
    AttrPutS( 'Descrição Linha DRE',      'SYS.M.160.Rejeitados_Cargas', 'COL2',  cProcesso );
    AttrPutS( 'Código Nível 01',          'SYS.M.160.Rejeitados_Cargas', 'COL3',  cProcesso );
    AttrPutS( 'Descrição Nível 01',       'SYS.M.160.Rejeitados_Cargas', 'COL4',  cProcesso );
    AttrPutS( 'Código Nível 02',          'SYS.M.160.Rejeitados_Cargas', 'COL5',  cProcesso );
    AttrPutS( 'Descrição Nível 02',       'SYS.M.160.Rejeitados_Cargas', 'COL6',  cProcesso );
    AttrPutS( 'Código Nível 03',          'SYS.M.160.Rejeitados_Cargas', 'COL7',  cProcesso );
    AttrPutS( 'Descrição Nível 03',       'SYS.M.160.Rejeitados_Cargas', 'COL8',  cProcesso );
    AttrPutS( 'Código Nível 04',          'SYS.M.160.Rejeitados_Cargas', 'COL9',  cProcesso );
    AttrPutS( 'Descrição Nível 04',       'SYS.M.160.Rejeitados_Cargas', 'COL10', cProcesso );
    AttrPutS( 'Código Nível 05',          'SYS.M.160.Rejeitados_Cargas', 'COL11', cProcesso );
    AttrPutS( 'Descrição Nível 05',       'SYS.M.160.Rejeitados_Cargas', 'COL12', cProcesso );
    AttrPutS( 'Código Nível 06',          'SYS.M.160.Rejeitados_Cargas', 'COL13', cProcesso );
    AttrPutS( 'Descrição Nível 06',       'SYS.M.160.Rejeitados_Cargas', 'COL14', cProcesso );
    AttrPutS( 'Código Nível 07',          'SYS.M.160.Rejeitados_Cargas', 'COL15', cProcesso );
    AttrPutS( 'Descrição Nível 07',       'SYS.M.160.Rejeitados_Cargas', 'COL16', cProcesso );
    AttrPutS( 'Código Nível 08',          'SYS.M.160.Rejeitados_Cargas', 'COL17', cProcesso );
    AttrPutS( 'Descrição Nível 08',       'SYS.M.160.Rejeitados_Cargas', 'COL18', cProcesso );
    AttrPutS( 'Bloco',                    'SYS.M.160.Rejeitados_Cargas', 'COL19', cProcesso );
    AttrPutS( 'Sinal',                    'SYS.M.160.Rejeitados_Cargas', 'COL20', cProcesso );
    AttrPutS( 'Ordem Apresentação',       'SYS.M.160.Rejeitados_Cargas', 'COL21', cProcesso );
    AttrPutS( 'Flag Linha Calculada',     'SYS.M.160.Rejeitados_Cargas', 'COL22', cProcesso );
          
    cExisteCabecalhoRejeitado = 1;
    cTipoErro = 2;
    If( cUtilizarDebug @= 'S'  );
      cMensagemProcesso = ' Processo concluido com registros salvos no cubo de Debug, verificar o cubo:    ' | cCuboReject;
    EndIf;
  EndIf;


  # Escreve o registro no arquivo de debug ou rejeitados
  # =================================================================================
  #AsciiOutput( cNomeArquivoRejeitadoCompleto , vElement , vDesc_Element , vCod_N1 , vDesc_N1 , vCod_N2 , vDesc_N2 , sContadorRegistro , cMensagemRegistro );
  
    cContadorRejeitados = cContadorRejeitados + 1;
    sLinha = 'L'|NumberToString( cContadorRejeitados );
    CellPutS( sContadorRegistro, cCuboReject, cProcesso, cUsuario, sLinha, 'Linha de Registro' );
    CellPutS( cMensagemRegistro, cCuboReject, cProcesso, cUsuario, sLinha, 'Mensagem' );
    CellPutS( vCodigo_Linha_DRE,        cCuboReject, cProcesso, cUsuario, sLinha, 'COL1'  );
    CellPutS( vDescricao_Linha_DRE,     cCuboReject, cProcesso, cUsuario, sLinha, 'COL2'  );
    CellPutS( vCodigo_Nivel_01,         cCuboReject, cProcesso, cUsuario, sLinha, 'COL3'  );
    CellPutS( vDescricao_Nivel_01,      cCuboReject, cProcesso, cUsuario, sLinha, 'COL4'  );
    CellPutS( vCodigo_Nivel_02,         cCuboReject, cProcesso, cUsuario, sLinha, 'COL5'  );
    CellPutS( vDescricao_Nivel_02,      cCuboReject, cProcesso, cUsuario, sLinha, 'COL6'  );
    CellPutS( vCodigo_Nivel_03,         cCuboReject, cProcesso, cUsuario, sLinha, 'COL7'  );
    CellPutS( vDescricao_Nivel_03,      cCuboReject, cProcesso, cUsuario, sLinha, 'COL8'  );
    CellPutS( vCodigo_Nivel_04,         cCuboReject, cProcesso, cUsuario, sLinha, 'COL9'  );
    CellPutS( vDescricao_Nivel_04,      cCuboReject, cProcesso, cUsuario, sLinha, 'COL10' );
    CellPutS( vCodigo_Nivel_05,         cCuboReject, cProcesso, cUsuario, sLinha, 'COL11' );
    CellPutS( vDescricao_Nivel_05,      cCuboReject, cProcesso, cUsuario, sLinha, 'COL12' );
    CellPutS( vCodigo_Nivel_06,         cCuboReject, cProcesso, cUsuario, sLinha, 'COL13' );
    CellPutS( vDescricao_Nivel_06,      cCuboReject, cProcesso, cUsuario, sLinha, 'COL14' );
    CellPutS( vCodigo_Nivel_07,         cCuboReject, cProcesso, cUsuario, sLinha, 'COL15' );
    CellPutS( vDescricao_Nivel_07,      cCuboReject, cProcesso, cUsuario, sLinha, 'COL16' );
    CellPutS( vCodigo_Nivel_08,         cCuboReject, cProcesso, cUsuario, sLinha, 'COL17' );
    CellPutS( vDescricao_Nivel_08,      cCuboReject, cProcesso, cUsuario, sLinha, 'COL18' );
    CellPutS( vBloco,                   cCuboReject, cProcesso, cUsuario, sLinha, 'COL19' );
    CellPutS( vSinal,                   cCuboReject, cProcesso, cUsuario, sLinha, 'COL20' );
    CellPutS( vOrdem_Apresentacao,      cCuboReject, cProcesso, cUsuario, sLinha, 'COL21' );
    CellPutS( vFlag_Linha_Calculada,    cCuboReject, cProcesso, cUsuario, sLinha, 'COL22' );

  # Limpa as variaveis e pula o registro
  # ============================
  IF( cExisteRegistroRejeitado = 1 );
     cExisteRegistroRejeitado = 0;
     cMensagemRegistro = '';
     cMensagemProcesso = ' Processo concluido com registros rejeitados, verificar o cubo:    ' | cCuboReject;
     ItemSkip;
  EndIf;

EndIf;



# ===================================================================================
# Grava os dados no cubo
# ===================================================================================
    s01 = vDescricao_Linha_DRE;
    s02 = vCodigo_Nivel_01;
    s03 = vDescricao_Nivel_01;
    s04 = vCodigo_Nivel_02;
    s05 = vDescricao_Nivel_02;
    s06 = vCodigo_Nivel_03;
    s07 = vDescricao_Nivel_03;
    s08 = vCodigo_Nivel_04;
    s09 = vDescricao_Nivel_04;
    s10 = vCodigo_Nivel_05;
    s11 = vDescricao_Nivel_05;
    s12 = vCodigo_Nivel_06;
    s13 = vDescricao_Nivel_06;
    s14 = vCodigo_Nivel_07;
    s15 = vDescricao_Nivel_07;
    s16 = vCodigo_Nivel_08;
    s17 = vDescricao_Nivel_08;
    s18 = vBloco;
    s19 = vSinal;
    s20 = vOrdem_Apresentacao;
    s21 = vFlag_Linha_Calculada;

    CellPutS( s01, cCuboDestino, vCodigo_Linha_DRE, 'Descrição Linha DRE' );
    CellPutS( s02, cCuboDestino, vCodigo_Linha_DRE, 'Código Nível 01' );
    CellPutS( s03, cCuboDestino, vCodigo_Linha_DRE, 'Descrição Nível 01' );
    CellPutS( s04, cCuboDestino, vCodigo_Linha_DRE, 'Código Nível 02' );
    CellPutS( s05, cCuboDestino, vCodigo_Linha_DRE, 'Descrição Nível 02' );
    CellPutS( s06, cCuboDestino, vCodigo_Linha_DRE, 'Código Nível 03' );
    CellPutS( s07, cCuboDestino, vCodigo_Linha_DRE, 'Descrição Nível 03' );
    CellPutS( s08, cCuboDestino, vCodigo_Linha_DRE, 'Código Nível 04' );
    CellPutS( s09, cCuboDestino, vCodigo_Linha_DRE, 'Descrição Nível 04' );
    CellPutS( s10, cCuboDestino, vCodigo_Linha_DRE, 'Código Nível 05' );
    CellPutS( s11, cCuboDestino, vCodigo_Linha_DRE, 'Descrição Nível 05' );
    CellPutS( s12, cCuboDestino, vCodigo_Linha_DRE, 'Código Nível 06' );
    CellPutS( s13, cCuboDestino, vCodigo_Linha_DRE, 'Descrição Nível 06' );
    CellPutS( s14, cCuboDestino, vCodigo_Linha_DRE, 'Código Nível 07' );
    CellPutS( s15, cCuboDestino, vCodigo_Linha_DRE, 'Descrição Nível 07' );
    CellPutS( s16, cCuboDestino, vCodigo_Linha_DRE, 'Código Nível 08' );
    CellPutS( s17, cCuboDestino, vCodigo_Linha_DRE, 'Descrição Nível 08' );
    CellPutS( s18, cCuboDestino, vCodigo_Linha_DRE, 'Bloco' );
    CellPutS( s19, cCuboDestino, vCodigo_Linha_DRE, 'Sinal' );
    CellPutS( s20, cCuboDestino, vCodigo_Linha_DRE, 'Ordem Apresentação' );
    CellPutS( s21, cCuboDestino, vCodigo_Linha_DRE, 'Flag Linha Calculada' );
#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****


# ===============================================================================================================
#EPILOGCOMMENT        Descrição:  Habilita log do cubo de destino, realiza CubeSaveData e registra log de status do processo.
# ===============================================================================================================

# =================================================================================
# Habilita o Log e salva dados no cubo
# =================================================================================
CellPutS ( 'YES', cCuboPropriedade, cCuboDestino, 'LOGGING' );
CubeSaveData ( cCuboDestino );


# =================================================================================
# Registra o Log de Erro ou Sucesso no Cubo de Controle
# =================================================================================
If( cTipoErro = 0 );
   cMensagemProcesso  = ' Processo concluído com sucesso';
EndIf;


s01	= TimSt( cHorarioInicio , '\Y-\m-\d \hh\im\ss' );
s02 	= cUsuario ;
s03 	= cMensagemProcesso ;
s04 	= sContadorRegistro  ;
s05 	= TimSt( Now - cHorarioInicio, ' \h:\i:\s') ;

CellPutS( s01 , cCuboParametro, cProcesso, 'DataHora Fim' );
CellPutS( s02 , cCuboParametro, cProcesso, 'Usuário' );
CellPutS( s03 , cCuboParametro, cProcesso, 'Mensagem de Log' );
CellPutS( s04 , cCuboParametro, cProcesso, 'Registros Processados' );
CellPutS( s05 , cCuboParametro, cProcesso, 'Tempo de Execução' );


If( cTipoErro = 2 );
  ItemReject( cMensagemProcesso );
EndIf;
#endregion