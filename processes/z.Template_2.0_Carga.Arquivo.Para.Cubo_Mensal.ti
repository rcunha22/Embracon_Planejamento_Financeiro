#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

# ===============================================================================================================
#GENERALCOMMENT             Descrição:          	Carrega dados CSV para o Cubo OPX.300.Despesas_Mensais
#GENERALCOMMENT             Responsável:   	    Lucas Almeida
#GENERALCOMMENT             Data Criação:    	Fevereiro/2025
#
#LASTCHANGE                 Alterações:
#LASTCHANGE                 Responsavel Alterações:
# ===============================================================================================================

# ===============================================================================================================
#PROLOGCOMMENT               Descrição:            Define arquivo fonte utlizando como filtro Parametros de Versão, Ano e Mês.
# ===============================================================================================================

# =================================================================================
# 									Glosário 
# =================================================================================
# Prefixos de Variáveis 
#
# v - Variáveis de entrada		- relacionado a origem de dados do turbo
# p - Parâmetros de entrada		- relacionado ao input realizado pelo usuário no momento de disparo do processo
# c - Constantes			- variáveis que receberão um valor fixo (Não serão alteradas durante o processo)
# n - Numerica
# s - String (Texto)
#
# Variáveis que deverão ser alteradas
# cCuboDestino			- Armazena o nome do cubo de destino
# cSuprimirConsolidado		- (S/N) - Suprimir a informação dos elementos consolidados
# cSuprimirZero			- (S/N) - Suprimir os valores 0 da view
# cSuprimirCamposCalculados		- (S/N) - Suprimir os campos calculados 
# cViewTemporaria			- (S/N) - Se a view deve ser temporária 
#
#
# Variáveis configuradas no cubo de controle 
# cCaminhoArquivoFonte 		- Busca o caminho de origem do processo no cubo de controle
# cCaminhoArquivoRejeitado 		- Busca o caminho de rejeitado do processo no cubo de controle
# cPrefixoArquivoFonte 		- Busca o prefixo do arquivo de origem do processo no cubo de controle
# cUtilizarDebug		 	- Busca no cubo de controle se ao executar o processo, será utilizado o modo Debug (Grava em arquivo texto o que seria gravado no cubo)
# cGravarLogAlteracao		- Busca no cubo de controle se ao executar o processo, serão gravados as alterações no cubo de destino
#
#
# Variáveis que não precisam ser alteradas
# cCuboParametro 			- Armazena o nome do cubo de parâmetro utilizado
# cCuboPropriedade		- Armazena o nome do cubo de sistema onde estão as principais propriedades dos cubos
# cExisteCabecalhoRejeitado		- Variável que irá controlar o cabeçalho do arquivo de rejeitado sejá criado uma única vez
# cExisteRegistroRejeitado 		- Variável que irá controlar se o registro possuí algum erro de integridade ou validação dos dados
# cHorarioInicio			- Armazena o horário de inicio do processo
# cMensagemRegistro		- Armazena a mensagem de erro/log do registro
# cMensagemProcesso		- Armazena a mensagem de erro do processo
# cProcesso			- Armazena o nome do processo
# cQtdRegistroRejeitado		- Contador de registros rejeitados
# cTipoErro			- Controla o tipo de erro (Erro 1 - Prologo / Erro 2 - Dados)
# cUsuario			- Armazena o nome do usuário ou chore que executou o processo

# =================================================================================
# Variáveis do padrão CTI que devem ser alteradas
# =================================================================================


# Informações do cubo de Destino
# ========================================
cCuboDestino		= 'OPX.300.Despesas_Mensais';



# =================================================================================
# Variáveis do padrão CTI não devem ser alteradas
# =================================================================================

# Recupera o usuário que executou o processo
# ========================================
cUsuario = IF( DimIx( '}Clients' , TM1User() ) = 0, 'Executed by Chore' , ATTRS('}Clients', TM1User(), '}TM1_DefaultDisplayValue') );
  

  
# Variáveis de controle do processo
# ========================================
cCuboPropriedade			= '}CubeProperties';
cCuboParGlobal			= 'SYS.140.Parametros_Globais';
cCuboParametro			= 'SYS.150.Controle_Cargas';
cCuboRejeitado          = 'SYS.160.Rejeitados_Cargas';
cCuboLogs                 = 'SYS.170.Log_Controle_Cargas';
cHorarioInicio			= Now();
cProcesso			= GetProcessName();
cMensagemRegistro	 	= '';
cMensagemProcesso 		= '';
cExisteRegistroRejeitado 		= 0;
cExisteCabecalhoRejeitado 		= 0;
cQtdRegistroRejeitado		= 0;
cTipoErro				= 0;
cContadorRegistro 			= 0;
cQtdRegistroRejeitadoCubo  = 0;


# Variáveis do cubo de Parâmetros Globais
# ========================================
cQtdRegistroRejeitadoMax = CellGetN( cCuboParGlobal, 'Parâmetros Globais', 'Qtd de Registros Rejeitados');
cNumLog = CellGetN( cCuboParGlobal, 'Parâmetros Globais', 'Qtd de Logs Históricos');


# Verifica se a quantidade de Registros rejeitados máxima foi preenchida
# ========================================
if (cQtdRegistroRejeitadoMax = 0); 
    cTipoErro = 1;
    cMensagemProcesso = 'A quantidade de Registros rejeitados máxima não foi informada, informe no cubo:   "' | cCuboParGlobal | '"' ;
    DataSourceType = 'NULL';
    ItemReject( cMensagemProcesso ); 
endif;


# Verifica se a quantidade de Logs foi preenchida
# ========================================
if (cNumLog = 0); 
    cTipoErro = 1;
    cMensagemProcesso = 'A quantidade de Logs a ser gravado não foi informada, informe no cubo:   "' | cCuboParGlobal | '"' ;
    DataSourceType = 'NULL';
    ItemReject( cMensagemProcesso ); 
endif;

# Variáveis de Debug
# ========================================
cUtilizarDebug            = pDebug;
cUtilizarDebug		 	= IF( cUtilizarDebug @= 'S' , 'S' , 'N' );


# =================================================================================
# Define variáveis locais de arquivo
# =================================================================================
cDelimitadorArquivo 		= ';';
cSeparadorMilhar			= '.';
cSeparadorDecimal			= ',';

DataSourceASCIIDelimiter 		= cDelimitadorArquivo;
DataSourceASCIIThousandSeparator 	= cSeparadorMilhar;
DataSourceASCIIDecimalSeparator 	= cSeparadorDecimal;
DataSourceQuoteCharacter 		= '';

# =================================================================================
# Transfere o log anterior para o Log seguinte
# Garante histórico de Logs
# =================================================================================
nNumLog = cNumLog - 1;

while (nNumLog > 0); 
    
    # Define o número de Log que será transferido
    # ======================================
    cLog = 'Log_' | NumberToString( nNumLog ); 

    # Obtem as variáveis do Log
    # ======================================
    s01 = CellGetS( cCuboLogs, cProcesso, cUsuario,  cLog, 'DataHora Inicio' );
    s02 = CellGetS( cCuboLogs, cProcesso, cUsuario,  cLog, 'DataHora Fim' );
    s03 = CellGetS( cCuboLogs, cProcesso, cUsuario,  cLog, 'Mensagem de Log' );
    s04 = CellGetS( cCuboLogs, cProcesso, cUsuario,  cLog, 'Registros Processados' );
    s05 = CellGetS( cCuboLogs, cProcesso, cUsuario,  cLog, 'Tempo de Execução' );

    if (s01 @<> '' & s02 @<>'' & s03 @<> '' & s04 @<> '' & s05 @<> '' ); 
        
        # Define o número de Log de destino
        # ======================================
        nNumLog_Seguinte = nNumLog + 1;
        cLog_Seguinte = 'Log_' | NumberToString( nNumLog_Seguinte );  

        # Grava os dados anteriores no log de destino
        # ======================================
        CellPutS( s01, cCuboLogs, cProcesso, cUsuario, cLog_Seguinte, 'DataHora Inicio' );
        CellPutS( s02, cCuboLogs, cProcesso, cUsuario, cLog_Seguinte, 'DataHora Fim'  );
        CellPutS( s03, cCuboLogs, cProcesso, cUsuario, cLog_Seguinte, 'Mensagem de Log' );
        CellPutS( s04, cCuboLogs, cProcesso, cUsuario, cLog_Seguinte, 'Registros Processados' );
        CellPutS( s05, cCuboLogs, cProcesso, cUsuario, cLog_Seguinte, 'Tempo de Execução' );

    endif;
       
    nNumLog = nNumLog - 1;
end;

# =================================================================================
# Grava Log atual no cubo de logs na posição 1
# =================================================================================
cMensagemProcesso	= 'Processo com falha, contate o administrador para verificar os logs de erro do sistema' ;
s01			= TimSt( cHorarioInicio , '\Y-\m-\d \hh\im\ss' );
s02 			= cMensagemProcesso ;
s03 			= '0' ;
s04 			= TimSt( cHorarioInicio - Now, '\Y-\m-\d \hh\im\ss' );

CellPutS( s01 , cCuboLogs, cProcesso, cUsuario,  'Log_1', 'DataHora Inicio' );
CellPutS( s01 , cCuboLogs, cProcesso, cUsuario,  'Log_1', 'DataHora Fim' );
CellPutS( s02 , cCuboLogs, cProcesso, cUsuario,  'Log_1', 'Mensagem de Log' );
CellPutS( s03 , cCuboLogs, cProcesso, cUsuario,  'Log_1', 'Registros Processados' );
CellPutS( s04 , cCuboLogs, cProcesso, cUsuario,  'Log_1', 'Tempo de Execução' );

# =================================================================================
# Validação dos parâmetros
# Teste 1 - O parâmetro só será validado caso exista uma dimensão atrelada
# Teste 2 - Parâmetro não informado
# Teste 3 - Se o parâmetro informado existe na dimensão de validação
# Teste 4* - Testa se a Versão informada é dinâmica 
# =================================================================================

# Parâmetro 1 - Ano
# =========================
sDim = 'ALL.D.Ano';
sElm = pAno;

If( Trim( sDim ) @<> '' );
  If( Trim( sElm ) @= '' );
    cTipoErro = 1;
    DataSourceType = 'NULL';
    cMensagemProcesso = 'O parâmetro    [ ' | sDim | ' ]    não foi Informado' ;
    ItemReject( cMensagemProcesso );
  ElseIf( DimIx( sDim , sElm ) = 0 );
    cTipoErro = 1;
    DataSourceType = 'NULL';
    cMensagemProcesso = 'O elemento    [ ' | sElm | ' ]    não existe na dimensão    [ ' | sDim | ' ]';
    ItemReject( cMensagemProcesso );
  EndIf;
EndIf;


# Parâmetro 2 - Versão
# =========================
sDim = 'ALL.D.Versao';
sElm = pVersao;
cValidaDinamica = 'S';

If( Trim( sDim ) @<> '' );
    If( Trim( sElm ) @= '' );
        cTipoErro = 1;
        DataSourceType = 'NULL';
        cMensagemProcesso = 'O parâmetro    [ ' | sDim | ' ]    não foi Informado' ;
        ItemReject( cMensagemProcesso );
    ElseIf( DimIx( sDim , sElm ) = 0 );
        cTipoErro = 1;
        DataSourceType = 'NULL';
        cMensagemProcesso = 'O elemento    [ ' | sElm | ' ]    não existe na dimensão    [ ' | sDim | ' ]';
        ItemReject( cMensagemProcesso );
    ElseIf( ELISANC( sDim, 'Dynamic Versions', sElm ) = 0 & cValidaDinamica @= 'S' );
        cTipoErro = 1;
        DataSourceType = 'NULL';
        cMensagemProcesso = 'O elemento    [ ' | sElm | ' ]    não é uma versão dinâmica';
        ItemReject( cMensagemProcesso );
    EndIf;
EndIf;



# =================================================================================
# DEFINIR CAMINHO DA ORIGEM DE DADOS
# 1 - Gerenciador de Arquivos interno -> Upload de arquivo
# 2 - Pasta externa -> Preencher "Caminho do Arquivo Fonte" e "Prefixo do Arquivo" no cubo de controle
# =================================================================================
if (pFileName@<>''); 
    # =================================================================================
    # 1 - Gerenciador de Arquivos interno
    # =================================================================================

    # Variáveis de caminho do Arquivo
    # ========================================
    cCaminhoArquivoFonte 		= '.\model_upload\';
    
    # =================================================================================
    # Validação do arquivo de origem e pasta
    # Teste 1- Se o arquivo fonte não for de extensão ".csv"
    # =================================================================================
    
    # Define o nome dos arquivos
    # ======================================================
    cNomeArquivoFonte	=  pFileName;
    
    # Aborta o processo se o arquivo fonte não for de extensão ".csv"
    # ======================================================
    cExtensaoArquivo = SUBST( pFileName, LONG( pFileName )-3, 4 );
    
    if (cExtensaoArquivo @<> '.csv'); 
        cTipoErro = 1;
        cMensagemProcesso = 'A extensão do arquivo não é ".csv", altere o arquivo para o modelo correto';
        DataSourceType = 'NULL';
        ItemReject( cMensagemProcesso ); 
    endif;

else;
    # =================================================================================
    # 2 - Pasta externa
    # =================================================================================

    # Variáveis de caminho do arquivo
    # ========================================
    cCaminhoArquivoFonte = CellGetS( cCuboParametro , cProcesso , 'Caminho do Arquivo Fonte' );
    
    # =================================================================================
    # Validação do arquivo de origem e pasta
    # Teste 1 - Se o caminho do arquivo fonte foi preenchido no cubo de controle
    # Teste 2 - Se o diretório do arquivo fonte existir
    # =================================================================================
        
    # Define o nome dos arquivos
    # ======================================================
    sPrefixo			= CellGetS( cCuboParametro, cProcesso, 'Prefixo do Arquivo' );    
    cNomeArquivoParametros = 
    sPrefixo 
    | '_' | pAno 
    | '_' | pVersao;
    cNomeArquivoFonte	=  cNomeArquivoParametros  | '.csv';

    
    # Aborta o processo se o caminho do arquivo fonte não foi informado
    # ======================================================
    IF( cCaminhoArquivoFonte @= '' );
       cTipoErro = 1;
       cMensagemProcesso = 'O caminho onde esta o arquivo fonte não foi informado, informe no cubo:   "' | cCuboParametro | '"' ;
       DataSourceType = 'NULL';
       ItemReject( cMensagemProcesso );
    ENDIF;
    
    # Insere o caractere "\" no final do caminho caso ainda não tenha
    # ======================================================
    cCaminhoArquivoFonte 	= IF( SUBST( cCaminhoArquivoFonte , LONG( cCaminhoArquivoFonte ) , 1 ) @<> '\' , cCaminhoArquivoFonte | '\' , cCaminhoArquivoFonte ); 


    # Aborta o processo se o diretorio do arquivo fonte não existir
    # ======================================================
    IF( FileExists( cCaminhoArquivoFonte ) = 0 );
       cTipoErro = 1;
       cMensagemProcesso = 'O diretório especificado para o arquivo fonte  "' | cCaminhoArquivoFonte | '"   não existe, informe no cubo:   "' | cCuboParametro | '"' ;
       DataSourceType = 'NULL';
       ItemReject( cMensagemProcesso );
    ENDIF;

endif;

# =================================================================================
# Validação do arquivo na pasta
# Teste 1 - Se o arquivo fonte não existir na pasta de origem
# =================================================================================

# Monta o caminho completo 
# ======================================================
cNomeArquivoFonteCompleto 	= cCaminhoArquivoFonte | cNomeArquivoFonte;



# Aborta o processo se o arquivo fonte não existir na pasta de origem
# ======================================================
IF( FileExists( cNomeArquivoFonteCompleto ) = 0 );
   cTipoErro = 1;
   cMensagemProcesso = 'O arquivo   "' | cNomeArquivoFonte | '"   não existe no diretorio:   "' | cCaminhoArquivoFonte | '"' ;
   DataSourceType = 'NULL';
   ItemReject( cMensagemProcesso );
ENDIF;

# Define o arquivo fonte como a nova fonte de dados deste processo
# ======================================================

DatasourceNameForServer		= cNomeArquivoFonteCompleto ;
DatasourceNameForClient		= cNomeArquivoFonteCompleto ;

# =================================================================================
# Grava Log no cubo de Propriedade
# =================================================================================

# Verifica se a opção de Gravar Log de Alteração foi preenchida
# ========================================
cGravarLogAlteracao		= CellGetS( cCuboParametro , cProcesso , 'Gerar Log de Alteração (S/N)' );

if (cGravarLogAlteracao @= ''); 
    cTipoErro = 1;
    cMensagemProcesso = 'A opção de gravar log de Alteração não foi informado, informe no cubo:   "' | cCuboParametro | '"' ;
    DataSourceType = 'NULL';
    ItemReject( cMensagemProcesso ); 
endif;

# Busca parametro para ativação de Log do Cubo
# ======================================================
sLog       	= IF ( cGravarLogAlteracao @= 'N', 'NO', 'YES' );


# Grava no cubo de Log
# ======================================================
CellPutS( sLog, cCuboPropriedade, cCuboDestino, 'LOGGING' );

# =================================================================================
# Definição de Limpeza de Dados
#
# 1 - Cubo de Destino
# 2 - Cubo de Rejeitados
# =================================================================================

# ======================================================
# 1 - Definição de Limpeza do Cubo de Destino
# ======================================================

cSuprimirConsolidado	= 'S';
cSuprimirZero		= 'S'; 
cSuprimirCamposCalculados	= 'S';
cViewTemporaria	 	= 'S';
nViewTemporaria		= If( cViewTemporaria @= 'S', 1, 0);

# Define nome da view e subset de limpeza
# ======================================================
cViewDestino	= 'processo.' | cProcesso | '.' | 'Limpeza' | '.' | TimSt( cHorarioInicio, '\Y-\m-\d \hh\im\ss' );
cSubsetDestino	= cViewDestino;

# Cria a view que será utilizada para a limpeza
# ======================================================
ViewCreate( cCuboDestino , cViewDestino , nViewTemporaria );

# Cria os subsets que serão utilizados para filtrar a view de limpeza
# ======================================================

cDimensao	= 'ALL.D.Ano';
cElemento	= pAno;
If( cDimensao @<> '');
  SubsetCreate( cDimensao, cSubsetDestino , nViewTemporaria );  
  ViewSubsetAssign( cCuboDestino , cViewDestino, cDimensao , cSubsetDestino );  
  SubsetElementInsert( cDimensao, cSubsetDestino, cElemento	, 1 );
EndIf;

cDimensao	= 'ALL.D.Versao';
cElemento	= pVersao;
If( cDimensao @<> '');
  SubsetCreate( cDimensao, cSubsetDestino , nViewTemporaria );  
  ViewSubsetAssign( cCuboDestino , cViewDestino, cDimensao , cSubsetDestino );  
  SubsetElementInsert( cDimensao, cSubsetDestino, cElemento	, 1 );
EndIf;

# Cria os subsets a partir de MDX
# ======================================================

# Definição de subset em Nível folha
# ===================================
cDimensao	= 'ALL.D.Centro_Custo';
cMDX		= '{TM1FILTERBYLEVEL(TM1SUBSETALL(['|cDimensao|'].['|cDimensao|']) , 0)}';
If( cDimensao @<> '');
  SubsetCreatebyMDX(cSubsetDestino, cMDX, nViewTemporaria);
  ViewSubsetAssign( cCuboDestino , cViewDestino, cDimensao , cSubsetDestino );  
  SubsetMDXSet(cDimensao, cSubsetDestino, '');
EndIf;

cDimensao	= 'ALL.D.Conta_Contabil';
cMDX		= '{TM1FILTERBYLEVEL(TM1SUBSETALL(['|cDimensao|'].['|cDimensao|']) , 0)}';
If( cDimensao @<> '');
  SubsetCreatebyMDX(cSubsetDestino, cMDX, nViewTemporaria);
  ViewSubsetAssign( cCuboDestino , cViewDestino, cDimensao , cSubsetDestino );  
  SubsetMDXSet(cDimensao, cSubsetDestino, '');
EndIf;

# Configuração da View
# ======================================================
ViewExtractSkipCalcsSet( cCuboDestino, cViewDestino, If( cSuprimirConsolidado @= 'S', 1, 0) );
ViewExtractSkipZeroesSet( cCuboDestino, cViewDestino, If( cSuprimirZero @= 'S', 1, 0)  );
ViewExtractSkipRuleValuesSet( cCuboDestino, cViewDestino, If( cSuprimirCamposCalculados @= 'S', 1, 0) );



# Apaga os valores da View criada
# ======================================================
ViewZeroOut( cCuboDestino , cViewDestino );

# =================================================================================
# 2 - Definição View de Limpeza do Cudo de Rejeitados
# =================================================================================

# Define as propriedades da view de limpeza
# ======================================================
cSuprimirConsolidado	= 'S';
cSuprimirZero		= 'S'; 
cSuprimirCamposCalculados	= 'S';
cViewTemporaria	 	= 'S';
nViewTemporaria		= If( cViewTemporaria @= 'S', 1, 0);


# Define os nomes da view e subset de limpeza
# ======================================================
cViewRejeitado	= 'processo.reject.' | cProcesso | '.' | 'Limpeza' | '.' | TimSt( cHorarioInicio, '\Y-\m-\d \hh\im\ss' );
cSubsetRejeitado	= cViewRejeitado;

# Cria a view que será utilizada para a limpeza 
# ======================================================
ViewCreate( cCuboRejeitado , cViewRejeitado , nViewTemporaria );

# Cria os subsets que serão utilizados para filtrar a view de limpeza
# ======================================================

cDimensao	= '}Processes';
cElemento	= cProcesso;
If( cDimensao @<> '');
  SubsetCreate( cDimensao, cSubsetRejeitado , nViewTemporaria );  
  ViewSubsetAssign( cCuboRejeitado , cViewRejeitado, cDimensao , cSubsetRejeitado );  
  SubsetElementInsert( cDimensao, cSubsetRejeitado, cElemento	, 1 );
EndIf;

cDimensao	= '}Clients';
cElemento	= cUsuario;
If( cDimensao @<> '');
  SubsetCreate( cDimensao, cSubsetRejeitado , nViewTemporaria );  
  ViewSubsetAssign( cCuboRejeitado , cViewRejeitado, cDimensao , cSubsetRejeitado );  
  SubsetElementInsert( cDimensao, cSubsetRejeitado, cElemento	, 1 );
EndIf;



# Configuração da View
# ======================================================
ViewExtractSkipCalcsSet( cCuboRejeitado, cViewRejeitado, If( cSuprimirConsolidado @= 'S', 1, 0) );
ViewExtractSkipZeroesSet( cCuboRejeitado, cViewRejeitado, If( cSuprimirZero @= 'S', 1, 0)  );
ViewExtractSkipRuleValuesSet( cCuboRejeitado, cViewRejeitado, If( cSuprimirCamposCalculados @= 'S', 1, 0) );


# Apaga os valores da View criada
# ======================================================
ViewZeroOut( cCuboRejeitado , cViewRejeitado );

#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****
#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****


# ===============================================================================================================
#DATACOMMENT        Descrição:  Grava dados no cubo
# ===============================================================================================================

# =================================================================================
# Verifica se o delimitador do arquivo está correto
# Verifica se a primeira variável na origem de dados possui o delimitador do arquivo
# =================================================================================
cElm = vAno;
sCheck = '';
cElmSize = LONG( vAno );
nCount = 1;

while (nCount <= cElmSize); 
    sCheck = SUBST( cElm, nCount, 1 ); 
    if (sCheck @= cDelimitadorArquivo); 
        cTipoErro = 1;
        cMensagemProcesso = 'O delimitador do arquivo definido no processo [ ' | cDelimitadorArquivo | ' ] está incorreto, favor corrigir' ;
        DataSourceType = 'NULL';
        ItemReject( cMensagemProcesso );
    endif;

    nCount = nCount + 1;
end;

# ===================================================================================
# Gera contador para o arquivo de debug ou registros rejeitados o e quantid. total de registros processados
# ===================================================================================
cContadorRegistro = cContadorRegistro + 1;
sContadorRegistro = NumberToString( cContadorRegistro );


# ===================================================================================
# Retira os espaços em branco das variáveis
# ===================================================================================
vAno = TRIM( vAno );
vVersao = TRIM( vVersao );
vEmpresa  = Trim( vEmpresa );
vConta  = Trim( vConta );
vCCusto  = Trim( vCCusto );


# ===================================================================================
# Trata as variáveis de valor
# ===================================================================================
vJan = If ( Trim (vJan) @= '-', '0', Trim (vJan));
vFev = If ( Trim (vFev) @= '-', '0', Trim (vFev));
vMar = If ( Trim (vMar) @= '-', '0', Trim (vMar));
vAbr = If ( Trim (vAbr) @= '-', '0', Trim (vAbr));
vMai = If ( Trim (vMai) @= '-', '0', Trim (vMai));
vJun = If ( Trim (vJun) @= '-', '0', Trim (vJun));
vJul = If ( Trim (vJul) @= '-', '0', Trim (vJul));
vAgo = If ( Trim (vAgo) @= '-', '0', Trim (vAgo));
vSet = If ( Trim (vSet) @= '-', '0', Trim (vSet));
vOut = If ( Trim (vOut) @= '-', '0', Trim (vOut));
vNov = If ( Trim (vNov) @= '-', '0', Trim (vNov));
vDez = If ( Trim (vDez) @= '-', '0', Trim (vDez));



# ===================================================================================
# Pula o Registro se todas as variáveis estiverem vazias
# ===================================================================================
IF('' @= vAno
& '' @= vVersao
& '' @= vEmpresa
& '' @= vConta
& '' @= vCCusto
& '' @= vJan
& '' @= vFev
& '' @= vMar
& '' @= vAbr
& '' @= vMai
& '' @= vJun
& '' @= vJul
& '' @= vAgo
& '' @= vSet
& '' @= vOut
& '' @= vNov
& '' @= vDez
);
  ItemSkip;
EndIf;


# ===================================================================================
# Força o número correto de digitos na variável
# ===================================================================================
cElm = vEmpresa;
cDigitos = 2;

if (cElm @<> ''); 
    vEmpresa = FILL( '0', cDigitos - LONG( Trim( cElm ) ) ) | Trim( cElm ); 
endif;


# ===================================================================================
# Marca o registro para rejeitar 
# Caso a variavel estiver em branco, se não existir na dimensão ou se for um totalizador
# ===================================================================================
sDim	= 'ALL.D.Ano';
sElm	= vAno;
sCol	= 'Ano';

If( cExisteRegistroRejeitado = 0 );
   If( sElm @= '' );
      cMensagemRegistro = 'A coluna    [ ' | sCol | ' ]    está em branco e é obrigatório ter algum valor';
      cExisteRegistroRejeitado = 1;
   ElseIf( DimIx( sDim , sElm ) = 0 );
      cMensagemRegistro = 'A coluna    [ ' | sCol | ' ]    contêm o valor:    [ ' | sElm | ' ]    que não existe na dimensão:    [ ' | sDim | ' ]';
      cExisteRegistroRejeitado = 1;
   ElseIf( dType( sDim , sElm ) @= 'C' );
      cMensagemRegistro = 'A coluna    [ ' | sCol | ' ]    contêm o valor:    [ ' | sElm | ' ]    que é um totalizador na dimensão:    [ ' | sDim | ' ]    totalizadores não podem receber carga';
      cExisteRegistroRejeitado = 1;
   EndIf;
EndIf;

# ===================================================================================
# Marca o registro para rejeitar 
# Caso a variavel estiver em branco, se não existir na dimensão ou se for um totalizador
