#   EndIf;
#EndIf;



# ===================================================================================
# DEBUG ou REJEIÇÃO
# Registra em arquivo os registros
# ===================================================================================
If( cExisteRegistroRejeitado = 1  %  cUtilizarDebug @= 'S' );

    # Define o Cabeçalho - Debug / Rejeitado
    # ========================================
    if (cUtilizarDebug @= 'S'); 
        cCabeçalhoMensagem = 'Mensagem_Debug';
    else;
        cCabeçalhoMensagem = 'Mensagem_Rejeitado';
    endif;


    # Escreve o cabeçalho do arquivo de registros rejeitados
    # =================================================================================
    If( cExisteCabecalhoRejeitado = 0);
        CellPutS( cCabeçalhoMensagem , cCuboRejeitado , cProcesso , cUsuario , 'Cabeçalho do Arquivo' , 'Mensagem' );
        CellPutS('Empresa', cCuboRejeitado, cProcesso, cUsuario,'Cabeçalho do Arquivo', 'COL1');
        CellPutS('Conta_Contabil', cCuboRejeitado, cProcesso, cUsuario,'Cabeçalho do Arquivo', 'COL2');
        CellPutS('Centro_custo', cCuboRejeitado, cProcesso, cUsuario,'Cabeçalho do Arquivo', 'COL3');
        CellPutS('Jan', cCuboRejeitado, cProcesso, cUsuario,'Cabeçalho do Arquivo', 'COL4');
        CellPutS('Fev', cCuboRejeitado, cProcesso, cUsuario,'Cabeçalho do Arquivo', 'COL5');
        CellPutS('Mar', cCuboRejeitado, cProcesso, cUsuario,'Cabeçalho do Arquivo', 'COL6');
        CellPutS('Abr', cCuboRejeitado, cProcesso, cUsuario,'Cabeçalho do Arquivo', 'COL7');
        CellPutS('Mai', cCuboRejeitado, cProcesso, cUsuario,'Cabeçalho do Arquivo', 'COL8');
        CellPutS('Jun', cCuboRejeitado, cProcesso, cUsuario,'Cabeçalho do Arquivo', 'COL9');
        CellPutS('Jul', cCuboRejeitado, cProcesso, cUsuario,'Cabeçalho do Arquivo', 'COL10');
        CellPutS('Ago', cCuboRejeitado, cProcesso, cUsuario,'Cabeçalho do Arquivo', 'COL11');
        CellPutS('Set', cCuboRejeitado, cProcesso, cUsuario,'Cabeçalho do Arquivo', 'COL12');
        CellPutS('Out', cCuboRejeitado, cProcesso, cUsuario,'Cabeçalho do Arquivo', 'COL13');
        CellPutS('Nov', cCuboRejeitado, cProcesso, cUsuario,'Cabeçalho do Arquivo', 'COL14');
        CellPutS('Dez', cCuboRejeitado, cProcesso, cUsuario,'Cabeçalho do Arquivo', 'COL15');
        CellPutS( 'Linha Do Registro'  , cCuboRejeitado , cProcesso , cUsuario , 'Cabeçalho do Arquivo' , 'Linha de Registro'      );
        cExisteCabecalhoRejeitado = 1;
    EndIf;

    # Escreve o registro no arquivo de debug ou rejeitados
    # =================================================================================
    vLinhaRegistro = cContadorRegistro + 1;
    nLinhaRegistro = NumberToString( vLinhaRegistro);
    if ( cQtdRegistroRejeitadoCubo < cQtdRegistroRejeitadoMax);
        vLinha = TRIM( 'L' | NumberToString(cQtdRegistroRejeitadoCubo ));
        
        CellPutS( cMensagemRegistro , cCuboRejeitado , cProcesso , cUsuario , vLinha , 'Mensagem' );
        CellPutS( vEmpresa, cCuboRejeitado, cProcesso, cUsuario,vLinha, 'COL1');
        CellPutS( vConta, cCuboRejeitado, cProcesso, cUsuario,vLinha, 'COL2');
        CellPutS( vCCusto, cCuboRejeitado, cProcesso, cUsuario,vLinha, 'COL3');
        CellPutS( vJan, cCuboRejeitado, cProcesso, cUsuario,vLinha, 'COL4');
        CellPutS( vFev, cCuboRejeitado, cProcesso, cUsuario,vLinha, 'COL5');
        CellPutS( vMar, cCuboRejeitado, cProcesso, cUsuario,vLinha, 'COL6');
        CellPutS( vAbr, cCuboRejeitado, cProcesso, cUsuario,vLinha, 'COL7');
        CellPutS( vMai, cCuboRejeitado, cProcesso, cUsuario,vLinha, 'COL8');
        CellPutS( vJun, cCuboRejeitado, cProcesso, cUsuario,vLinha, 'COL9');
        CellPutS( vJul, cCuboRejeitado, cProcesso, cUsuario,vLinha, 'COL10');
        CellPutS( vAgo, cCuboRejeitado, cProcesso, cUsuario,vLinha, 'COL11');
        CellPutS( vSet, cCuboRejeitado, cProcesso, cUsuario,vLinha, 'COL12');
        CellPutS( vOut, cCuboRejeitado, cProcesso, cUsuario,vLinha, 'COL13');
        CellPutS( vNov, cCuboRejeitado, cProcesso, cUsuario,vLinha, 'COL14');
        CellPutS( vDez, cCuboRejeitado, cProcesso, cUsuario,vLinha, 'COL15');
        CellPutS( nLinhaRegistro  , cCuboRejeitado , cProcesso , cUsuario , vLinha , 'Linha de Registro'     );
    endif;    
    
    
    # Limpa as variaveis e pula o registro
    # ============================
    IF( cExisteRegistroRejeitado = 1 );
         cExisteRegistroRejeitado = 0;
         cMensagemRegistro = '';
         cTipoErro = 2;
         cMensagemProcesso = ' Processo concluido com registros rejeitados, verificar o Cubo [ '| cCuboRejeitado | ' ] na Guia de rejeitados';
         cQtdRegistroRejeitadoCubo = cQtdRegistroRejeitadoCubo + 1;
         ItemSkip;
    EndIf;

EndIf;

# ===================================================================================
# Grava os dados no cubo
# ===================================================================================

S01  =  pAno;
S02  =  pVersao;
S03  =  vEmpresa;
S04  =  vConta;
S05  =  vCCusto;

S06.1   =   'Janeiro';
S06.2   =   'Fevereiro';
S06.3   =   'Março';
S06.4   =   'Abril';
S06.5   =   'Maio';
S06.6   =   'Junho';
S06.7   =   'Julho';
S06.8   =   'Agosto';
S06.9   =   'Setembro';
S06.10   =   'Outubro';
S06.11   =   'Novembro';
S06.12   =   'Dezembro';

n01  =  StringToNumberEx( vJan, cSeparadorDecimal, cSeparadorMilhar );
n02  =  StringToNumberEx( vFev, cSeparadorDecimal, cSeparadorMilhar );
n03  =  StringToNumberEx( vMar, cSeparadorDecimal, cSeparadorMilhar );
n04  =  StringToNumberEx( vAbr, cSeparadorDecimal, cSeparadorMilhar );
n05  =  StringToNumberEx( vMai, cSeparadorDecimal, cSeparadorMilhar );
n06  =  StringToNumberEx( vJun, cSeparadorDecimal, cSeparadorMilhar );
n07  =  StringToNumberEx( vJul, cSeparadorDecimal, cSeparadorMilhar );
n08  =  StringToNumberEx( vAgo, cSeparadorDecimal, cSeparadorMilhar );
n09  =  StringToNumberEx( vSet, cSeparadorDecimal, cSeparadorMilhar );
n10  =  StringToNumberEx( vOut, cSeparadorDecimal, cSeparadorMilhar );
n11  =  StringToNumberEx( vNov, cSeparadorDecimal, cSeparadorMilhar );
n12  =  StringToNumberEx( vDez, cSeparadorDecimal, cSeparadorMilhar );

CellIncrementN(n01, cCuboDestino, S01, S02, S03, S04, S05, s06.1);
CellIncrementN(n02, cCuboDestino, S01, S02, S03, S04, S05, s06.2);
CellIncrementN(n03, cCuboDestino, S01, S02, S03, S04, S05, s06.3);
CellIncrementN(n04, cCuboDestino, S01, S02, S03, S04, S05, s06.4);
CellIncrementN(n05, cCuboDestino, S01, S02, S03, S04, S05, s06.5);
CellIncrementN(n06, cCuboDestino, S01, S02, S03, S04, S05, s06.6);
CellIncrementN(n07, cCuboDestino, S01, S02, S03, S04, S05, s06.7);
CellIncrementN(n08, cCuboDestino, S01, S02, S03, S04, S05, s06.8);
CellIncrementN(n09, cCuboDestino, S01, S02, S03, S04, S05, s06.9);
CellIncrementN(n10, cCuboDestino, S01, S02, S03, S04, S05, s06.10);
CellIncrementN(n11, cCuboDestino, S01, S02, S03, S04, S05, s06.11);
CellIncrementN(n12, cCuboDestino, S01, S02, S03, S04, S05, s06.12);
# ( OPCIONAL )
# Caso o arquivo não possa ter registros duplicados 
# CellPutN( n01, cCuboDestino, s01, s02, s03, s04, s05, s06 );

#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****


# ===============================================================================================================
#EPILOGCOMMENT        Descrição:  Habilita log do cubo de destino, realiza CubeSaveData e registra log de status do processo.
# ===============================================================================================================

# =================================================================================
# Habilita o Log e salva dados no cubo
# =================================================================================
CellPutS ( 'YES', cCuboPropriedade, cCuboDestino, 'LOGGING' );
CubeSaveData ( cCuboDestino );

# =================================================================================
# Grava os parâmetros no Log de Transição
# =================================================================================
s01 = pAno;
s02 = pVersao;

LogOutput( 'INFO', 'Parâmetros do processo: ' |  s01);
LogOutput( 'INFO', 'Parâmetros do processo: ' |  s02);

# =================================================================================
# Registra o Log de Erro ou Sucesso no Cubo de Controle
# =================================================================================
If( cTipoErro = 0 );
   cMensagemProcesso  = ' Processo concluído com sucesso';
EndIf;


# =================================================================================
# Registra o Log de Erro ou Sucesso no Cubo de Logs
# =================================================================================
s01	  = TimSt( cHorarioInicio , '\Y-\m-\d \hh\im\ss' );
s02 	= cMensagemProcesso ;
s03 	= sContadorRegistro  ;
s04 	= TimSt( Now - cHorarioInicio, ' \h:\i:\s') ;

CellPutS( s01 , cCuboLogs, cProcesso, cUsuario, 'Log_1', 'DataHora Fim' );
CellPutS( s02 , cCuboLogs, cProcesso, cUsuario, 'Log_1', 'Mensagem de Log' );
CellPutS( s03 , cCuboLogs, cProcesso, cUsuario, 'Log_1', 'Registros Processados' );
CellPutS( s04 , cCuboLogs, cProcesso, cUsuario, 'Log_1', 'Tempo de Execução' );


If( cTipoErro = 2 );
  ItemReject( cMensagemProcesso );
EndIf;
#endregion