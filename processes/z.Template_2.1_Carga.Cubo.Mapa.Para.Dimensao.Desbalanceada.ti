# =================================================================================
# Cria Hierarquia virtual  de conta Contabil 
# Hierarquia de Empresa e Centro de Custo
# 1 - Define componentes da Hierarquia Virtual
# 2 - Monta a Hierarquia a partir da condição
# =================================================================================

# Conta Gerencial
# ===================
cTotHier = 'Conta Gerencial';
cElmHier   = CellGetS( cCuboMapa,vElement, 'Conta Gerencial' );

# Gerais
# ===================
sElm = vElement;
sDim = cDimensao;
sTot = cTotalizadorCG;
sHier = cHierarquiaCG;


# Monta a Hierarquia 
# ==========================
IF ( cElmHier @<> '' );
    HierarchyElementComponentAddDirect  ( sDim, sHier, cTotalizadorCG, cTotHier, 1 );
    HierarchyElementComponentAddDirect  ( sDim, sHier, cTotHier, cElmHier, 1 );
    HierarchyElementComponentAddDirect  ( sDim, sHier, cElmHier, sElm, 1 );
Endif;


#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****


# ===============================================================================================================
#DATACOMMENT        Descrição:  Atualiza alias e atributos da dimensão.
# ===============================================================================================================

if (DIMIX( cDimensao, vElement )=0); 
    ItemSkip; 
endif;
# ===================================================================================
# Atualiza Atributos
# 1 - Define o Atributo
# 2 - Define o Elemento que receberá Atributo
# 3 - Define qual valor este elemento irá receber no atributo selecionado
# 4 - Apaga o valor anterior caso exista e atualiza o Atributo
# ===================================================================================

#  Elemento
#==========================================
sAtributo       = 'Código e Descrição';
cElm 		= vElement;
cDesc 	= CellGetS ( cCuboMapa, vElement, 'Desc Element' );

sValorAtr = cElm | ' - ' | cDesc; 

if (ATTRS( cDimensao, cElm, sAtributo ) @<> ''); 
    AttrPutS( '', cDimensao, cElm, sAtributo );
endif;

AttrPutS( sValorAtr , cDimensao, cElm, sAtributo );

#  Nivel 1
#==========================================
sAtributo       = 'Código e Descrição';
cElm 		= CellGetS ( cCuboMapa, vElement, 'Cod N1' );
cDesc 	= CellGetS ( cCuboMapa, vElement, 'Desc N1' );

sValorAtr = cElm | ' - ' | cDesc; 

if (ATTRS( cDimensao, cElm, sAtributo ) @<> ''); 
    AttrPutS( '', cDimensao, cElm, sAtributo );
endif;

AttrPutS( sValorAtr , cDimensao, cElm, sAtributo );



#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****


# ===============================================================================================================
#EPILOGCOMMENT        Descrição:  Habilita log do cubo de destino, realiza CubeSaveData e registra log de status do processo.
# ===============================================================================================================
# =================================================================================
# Registra o Log de Erro ou Sucesso no Cubo de Controle
# =================================================================================
If( cTipoErro = 0 );
   cMensagemProcesso  = ' Processo concluído com sucesso';
EndIf;


# =================================================================================
# Registra o Log de Erro ou Sucesso no Cubo de Logs
# =================================================================================
s01	  = TimSt( cHorarioInicio , '\Y-\m-\d \hh\im\ss' );
s02 	= cMensagemProcesso ;
s03 	= sContadorRegistro  ;
s04 	= TimSt( Now - cHorarioInicio, ' \h:\i:\s') ;

CellPutS( s01 , cCuboLogs, cProcesso, cUsuario, 'Log_1', 'DataHora Fim' );
CellPutS( s02 , cCuboLogs, cProcesso, cUsuario, 'Log_1', 'Mensagem de Log' );
CellPutS( s03 , cCuboLogs, cProcesso, cUsuario, 'Log_1', 'Registros Processados' );
CellPutS( s04 , cCuboLogs, cProcesso, cUsuario, 'Log_1', 'Tempo de Execução' );

If( cTipoErro = 2 );
  ItemReject( cMensagemProcesso );
EndIf;


# =================================================================================
# Executa processo que consolida elementos orfaos
# =================================================================================
ExecuteProcess
  ( 'zCTI.Dim.Hierarchy.Consolidate.Orphans'
  , 'pDim'			, cDimensao
  , 'pTotalizador'		, 'Total Histórico'
  , 'pTotalizadorFilho'	, ''
   );


#endregion