#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****


# ===============================================================================================================
#GENERALCOMMENT             Descrição:          	Atualiza dimensão ALL.D.Conta_Contabil
#GENERALCOMMENT             Responsável:   	    Lucas Almeida
#GENERALCOMMENT             Data Criação:    	Fevereito/2020
#
#LASTCHANGE                 Alterações:
#LASTCHANGE                 Responsavel Alterações:
# ===============================================================================================================

# ===============================================================================================================
#PROLOGCOMMENT               Descrição:            		Atualiza dimensão de hierarquia desbalanceada ALL.D.Conta_Contabil através 
#PROLOGCOMMENT               	            		do mapa MAP.100.Conta_Contabil.
# ===============================================================================================================

# =================================================================================
# 									Glosário 
# =================================================================================
# Prefixos de Variáveis 
#
# v - Variáveis de entrada		- relacionado a origem de dados do turbo
# p - Parâmetros de entrada		- relacionado ao input realizado pelo usuário no momento de disparo do processo
# c - Constantes			- variáveis que receberão um valor fixo (Não serão alteradas durante o processo)
# n - Numerica
# s - String (Texto)
#
# Variáveis que deverão ser alteradas
# cDimensao			- Armazena o nome da dimensão
# cCuboMapa			- Armazena o nome do cubo de origem
# cTotalizador			- Armazena o nome do totalizador da dimensão
#
#
# Variáveis que não precisam ser alteradas
# cCuboParametro 			- Armazena o nome do cubo de parâmetro utilizado
# cHorarioInicio			- Armazena o horário de inicio do processo
# cMensagemRegistro		- Armazena a mensagem de erro/log do registro
# cMensagemProcesso		- Armazena a mensagem de erro do processo
# cProcesso			- Armazena o nome do processo
# cUsuario			- Armazena o nome do usuário ou chore que executou o processo

# =================================================================================
# Variáveis do padrão CTI que devem ser alteradas
# =================================================================================


# Informações da dimensão e cubo mapa
# ========================================
cDimensao		= 'ALL.D.Conta_Contabil';
cCuboMapa		= 'MAP.100.Conta_Contabil';



# =================================================================================
# Variáveis do padrão CTI não devem ser alteradas
# =================================================================================

# Recupera o usuário que executou o processo
# ========================================
cUsuario = IF( DimIx( '}Clients' , TM1User() ) = 0, 'Executed by Chore' , ATTRS('}Clients', TM1User(), '}TM1_DefaultDisplayValue') );
  

  
# Variáveis de controle do processo
# ========================================
cCuboParGlobal			= 'SYS.140.Parametros_Globais';
cCuboParametro			= 'SYS.150.Controle_Cargas';
cCuboRejeitado          = 'SYS.160.Rejeitados_Cargas';
cCuboLogs                 = 'SYS.170.Log_Controle_Cargas';
cHorarioInicio			= Now();
cProcesso			= GetProcessName();
cMensagemProcesso 		= '';
cContadorRegistro 			= 0;
cExisteRegistroRejeitado = 0;
cQtdRegistroRejeitadoCubo  = 1;
 cExisteCabecalhoRejeitado = 0;

# Variáveis do cubo de Parâmetros Globais
# ========================================
cQtdRegistroRejeitadoMax = CellGetN( cCuboParGlobal, 'Parâmetros Globais', 'Qtd de Registros Rejeitados');
cNumLog = CellGetN( cCuboParGlobal, 'Parâmetros Globais', 'Qtd de Logs Históricos');


# Verifica se a quantidade de Registros rejeitados máxima foi preenchida
# ========================================
if (cQtdRegistroRejeitadoMax = 0); 
    cTipoErro = 1;
    cMensagemProcesso = 'A quantidade de Registros rejeitados máxima não foi informada, informe no cubo:   "' | cCuboParGlobal | '"' ;
    DataSourceType = 'NULL';
    ItemReject( cMensagemProcesso ); 
endif;


# Verifica se a quantidade de Logs foi preenchida
# ========================================
if (cNumLog = 0); 
    cTipoErro = 1;
    cMensagemProcesso = 'A quantidade de Logs a ser gravado não foi informada, informe no cubo:   "' | cCuboParGlobal | '"' ;
    DataSourceType = 'NULL';
    ItemReject( cMensagemProcesso ); 
endif;

# Variáveis de Debug
# ========================================
cUtilizarDebug            = pDebug;
cUtilizarDebug		 	= IF( cUtilizarDebug @= 'S' , 'S' , 'N' );


# =================================================================================
# Transfere o log anterior para o Log seguinte
# Garante histórico de Logs
# =================================================================================
nNumLog = cNumLog - 1;

while (nNumLog > 0); 
    
    # Define o número de Log que será transferido
    # ======================================
    cLog = 'Log_' | NumberToString( nNumLog ); 

    # Obtem as variáveis do Log
    # ======================================
    s01 = CellGetS( cCuboLogs, cProcesso, cUsuario,  cLog, 'DataHora Inicio' );
    s02 = CellGetS( cCuboLogs, cProcesso, cUsuario,  cLog, 'DataHora Fim' );
    s03 = CellGetS( cCuboLogs, cProcesso, cUsuario,  cLog, 'Mensagem de Log' );
    s04 = CellGetS( cCuboLogs, cProcesso, cUsuario,  cLog, 'Registros Processados' );
    s05 = CellGetS( cCuboLogs, cProcesso, cUsuario,  cLog, 'Tempo de Execução' );

    if (s01 @<> '' & s02 @<>'' & s03 @<> '' & s04 @<> '' & s05 @<> '' ); 
        
        # Define o número de Log de destino
        # ======================================
        nNumLog_Seguinte = nNumLog + 1;
        cLog_Seguinte = 'Log_' | NumberToString( nNumLog_Seguinte );  

        # Grava os dados anteriores no log de destino
        # ======================================
        CellPutS( s01, cCuboLogs, cProcesso, cUsuario, cLog_Seguinte, 'DataHora Inicio' );
        CellPutS( s02, cCuboLogs, cProcesso,  cUsuario, cLog_Seguinte, 'DataHora Fim'  );
        CellPutS( s03, cCuboLogs, cProcesso,  cUsuario, cLog_Seguinte, 'Mensagem de Log' );
        CellPutS( s04, cCuboLogs, cProcesso,  cUsuario, cLog_Seguinte, 'Registros Processados' );
        CellPutS( s05, cCuboLogs, cProcesso,  cUsuario, cLog_Seguinte, 'Tempo de Execução' );

    endif;
       
    nNumLog = nNumLog - 1;
end;

# =================================================================================
# Grava Log atual no cubo de logs na posição 1
# =================================================================================
cMensagemProcesso	= 'Processo com falha, contate o administrador para verificar os logs de erro do sistema' ;
s01			= TimSt( cHorarioInicio , '\Y-\m-\d \hh\im\ss' );
s02 			= cMensagemProcesso ;
s03 			= '0' ;
s04 			= TimSt( cHorarioInicio - Now, '\Y-\m-\d \hh\im\ss' );

CellPutS( s01 , cCuboLogs, cProcesso, cUsuario,  'Log_1', 'DataHora Inicio' );
CellPutS( s01 , cCuboLogs, cProcesso, cUsuario,  'Log_1', 'DataHora Fim' );
CellPutS( s02 , cCuboLogs, cProcesso, cUsuario,  'Log_1', 'Mensagem de Log' );
CellPutS( s03 , cCuboLogs, cProcesso, cUsuario,  'Log_1', 'Registros Processados' );
CellPutS( s04 , cCuboLogs, cProcesso, cUsuario,  'Log_1', 'Tempo de Execução' );



# =================================================================================
# Cria Totalizadores
# =================================================================================
cTotalizador = CellGetS( cCuboParametro, cProcesso, 'Título do Totalizador' );

# =================================================================================
# Limpa todos consolidadores da dimensão
# =================================================================================
# Totalizador 1
# ============================
#** Busca a Qtde de Elementos na dimensão
vElemento = DimSiz(cDimensao);
vCount = vElemento;
#** Checa todos os elementos da dimensão e recria somente elementos dos níveis maiores
WHILE(vCount <> 0);
    vElementoN = DimNm(cDimensao, vCount);
    if (ELISANC( cDimensao, cTotalizador, vElementoN )<>0);        
        IF(DTYPE(cDimensao, vElementoN) @= 'C');
             DimensionElementDelete(cDimensao, vElementoN);
        ENDIF; 
    endif;
    vCount = vCount - 1;
END;

# =================================================================================
# Insere Totalizadores na Dimensão e adiciona elemento neutro
# =================================================================================
# Totalizador 1
# ============================
If(DIMIX( cDimensao, cTotalizador ) = 0);
    if (cTotalizador @<> ''); 
        DimensionElementInsert ( cDimensao, '', cTotalizador, 'C' );
    endif;
endif;

# =================================================================================
# Define a Ordem da Dimensão 
# =================================================================================
DimensionSortOrder ( cDimensao, 'ByName', 'Ascending', 'ByHierarchy' , 'Ascending' );

# =================================================================================
# Hierarquia Virtual
# =================================================================================
cHierarquiaCG = 'Hier - Conta Gerencial';
cTotalizadorCG = 'Total Conta Gerencial';
 
IF (HierarchyExists( cDimensao, cHierarquiaCG ) =1);
    HierarchyDeleteAllElements(cDimensao, cHierarquiaCG );
else;
    HierarchyCreate( cDimensao, cHierarquiaCG );
endif;

HierarchyElementInsertDirect( cDimensao, cHierarquiaCG, '', cTotalizadorCG, 'C' );

# =================================================================================
# Define a Ordem da Hierarquia 
# =================================================================================
HierarchySortOrder( cDimensao, cHierarquiaCG, 'ByName', 'Ascending', 'ByHierarchy' , 'Ascending' );

#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****


# ===============================================================================================================
#METADATACOMMENT        Descrição:  Atualiza estrutura da dimensão desbalanceada considerando os niveis existentes no cubo mapa.
# ===============================================================================================================
# ===================================================================================
# Gera contador para quantidade total de registros processados
# ===================================================================================
cContadorRegistro = cContadorRegistro + 1;
sContadorRegistro = NumberToString( cContadorRegistro );

# =================================================================================
# Busca Variáveis do Cubo Mapa
# =================================================================================
sNivel1 	= CellGetS ( cCuboMapa, vElement, 'Cod N1' );
sNivel2 	= CellGetS ( cCuboMapa, vElement, 'Cod N2' );
sNivel3 	= '';
sNivel4 	= '';
sNivel5 	= '';
sNivel6 	= '';
sNivel7 	= '';
sNivel8 	= '';
sNivel9 	= '';
sNivel10 	= '';

# =================================================================================
# Checa possível duplicata 
# =================================================================================
sParenteN1 = ELPAR( cDimensao, sNivel1, 1 );
sParenteN2 = ELPAR( cDimensao, sNivel2, 1 );
sParenteN3 = ELPAR( cDimensao, sNivel3, 1 );
sParenteN4 = ELPAR( cDimensao, sNivel4, 1 );
sParenteN5 = ELPAR( cDimensao, sNivel5, 1 );
sParenteN6 = ELPAR( cDimensao, sNivel6, 1 );
sParenteN7 = ELPAR( cDimensao, sNivel7, 1 );
sParenteN8 = ELPAR( cDimensao, sNivel8, 1 );
sParenteN9 = ELPAR( cDimensao, sNivel9, 1 );
sParenteN10 = ELPAR( cDimensao, sNivel10, 1 );

if (cExisteRegistroRejeitado=0);   
    if (sParenteN1 @<> sNivel2
        & sParenteN1 @<> sNivel3
        & sParenteN1 @<> sNivel4
        & sParenteN1 @<> sNivel5
        & sParenteN1 @<> sNivel6
        & sParenteN1 @<> sNivel7
        & sParenteN1 @<> sNivel8
        & sParenteN1 @<> sNivel9
        & sParenteN1 @<> sNivel10
        & sParenteN1 @<> cTotalizador); 
        cMensagemRegistro = 'O parente informado para o elemento  [ ' | vElement | ' ] não condiz com o parente já cadastrado na dimensão:  [  '| sParenteN1 |'  ].';
        cExisteRegistroRejeitado = 1;
    endif;
endif;

if (cExisteRegistroRejeitado=0);   
    if (sParenteN2 @<> sNivel1
        & sParenteN2 @<> sNivel3
        & sParenteN2 @<> sNivel4
        & sParenteN2 @<> sNivel5
        & sParenteN2 @<> sNivel6
        & sParenteN2 @<> sNivel7
        & sParenteN2 @<> sNivel8
        & sParenteN2 @<> sNivel9
        & sParenteN2 @<> sNivel10
        & sParenteN2 @<> cTotalizador); 
        cMensagemRegistro = 'O parente informado para o elemento  [ ' | vElement | ' ] não condiz com o parente já cadastrado na dimensão:  [  '| sParenteN2 |'  ].';
        cExisteRegistroRejeitado = 1;
    endif;
endif;

if (cExisteRegistroRejeitado=0);   
    if (sParenteN3 @<> sNivel1
        & sParenteN3 @<> sNivel2
        & sParenteN3 @<> sNivel4
        & sParenteN3 @<> sNivel5
        & sParenteN3 @<> sNivel6
        & sParenteN3 @<> sNivel7
        & sParenteN3 @<> sNivel8
        & sParenteN3 @<> sNivel9
        & sParenteN3 @<> sNivel10
        & sParenteN3 @<> cTotalizador); 
        cMensagemRegistro = 'O parente informado para o elemento  [ ' | vElement | ' ] não condiz com o parente já cadastrado na dimensão:  [  '| sParenteN3 |'  ].';
        cExisteRegistroRejeitado = 1;
    endif;
endif;

if (cExisteRegistroRejeitado=0);   
    if (sParenteN4 @<> sNivel1
        & sParenteN4 @<> sNivel2
        & sParenteN4 @<> sNivel3
        & sParenteN4 @<> sNivel5
        & sParenteN4 @<> sNivel6
        & sParenteN4 @<> sNivel7
        & sParenteN4 @<> sNivel8
        & sParenteN4 @<> sNivel9
        & sParenteN4 @<> sNivel10
        & sParenteN4 @<> cTotalizador); 
        cMensagemRegistro = 'O parente informado para o elemento  [ ' | vElement | ' ] não condiz com o parente já cadastrado na dimensão:  [  '| sParenteN4 |'  ].';
        cExisteRegistroRejeitado = 1;
    endif;
endif;

if (cExisteRegistroRejeitado=0);   
    if (sParenteN5 @<> sNivel1
        & sParenteN5 @<> sNivel2
        & sParenteN5 @<> sNivel3
        & sParenteN5 @<> sNivel4
        & sParenteN5 @<> sNivel6
        & sParenteN5 @<> sNivel7
        & sParenteN5 @<> sNivel8
        & sParenteN5 @<> sNivel9
        & sParenteN5 @<> sNivel10
        & sParenteN5 @<> cTotalizador); 
        cMensagemRegistro = 'O parente informado para o elemento  [ ' | vElement | ' ] não condiz com o parente já cadastrado na dimensão:  [  '| sParenteN5 |'  ].';
        cExisteRegistroRejeitado = 1;
    endif;
endif;

if (cExisteRegistroRejeitado=0);   
    if (sParenteN5 @<> sNivel1
        & sParenteN6 @<> sNivel2
        & sParenteN6 @<> sNivel3
        & sParenteN6 @<> sNivel4
        & sParenteN6 @<> sNivel5
        & sParenteN6 @<> sNivel7
        & sParenteN6 @<> sNivel8
        & sParenteN6 @<> sNivel9
        & sParenteN6 @<> sNivel10
        & sParenteN6 @<> cTotalizador); 
        cMensagemRegistro = 'O parente informado para o elemento  [ ' | vElement | ' ] não condiz com o parente já cadastrado na dimensão:  [  '| sParenteN6 |'  ].';
        cExisteRegistroRejeitado = 1;
    endif;
endif;

if (cExisteRegistroRejeitado=0);   
    if (sParenteN7 @<> sNivel1
        & sParenteN7 @<> sNivel2
        & sParenteN7 @<> sNivel3
        & sParenteN7 @<> sNivel4
        & sParenteN7 @<> sNivel5
        & sParenteN7 @<> sNivel6
        & sParenteN7 @<> sNivel8
        & sParenteN7 @<> sNivel9
        & sParenteN7 @<> sNivel10
        & sParenteN7 @<> cTotalizador); 
        cMensagemRegistro = 'O parente informado para o elemento  [ ' | vElement | ' ] não condiz com o parente já cadastrado na dimensão:  [  '| sParenteN7 |'  ].';
        cExisteRegistroRejeitado = 1;
    endif;
endif;

if (cExisteRegistroRejeitado=0);   
    if (sParenteN8 @<> sNivel1
        & sParenteN8 @<> sNivel2
        & sParenteN8 @<> sNivel3
        & sParenteN8 @<> sNivel4
        & sParenteN8 @<> sNivel5
        & sParenteN8 @<> sNivel6
        & sParenteN8 @<> sNivel7
        & sParenteN8 @<> sNivel9
        & sParenteN8 @<> sNivel10
        & sParenteN8 @<> cTotalizador); 
        cMensagemRegistro = 'O parente informado para o elemento  [ ' | vElement | ' ] não condiz com o parente já cadastrado na dimensão:  [  '| sParenteN8 |'  ].';
        cExisteRegistroRejeitado = 1;
    endif;
endif;

if (cExisteRegistroRejeitado=0);   
    if (sParenteN9 @<> sNivel1
        & sParenteN9 @<> sNivel2
        & sParenteN9 @<> sNivel3
        & sParenteN9 @<> sNivel4
        & sParenteN9 @<> sNivel5
        & sParenteN9 @<> sNivel6
        & sParenteN9 @<> sNivel7
        & sParenteN9 @<> sNivel8
        & sParenteN9 @<> sNivel10
        & sParenteN9 @<> cTotalizador); 
        cMensagemRegistro = 'O parente informado para o elemento  [ ' | vElement | ' ] não condiz com o parente já cadastrado na dimensão:  [  '| sParenteN9 |'  ].';
        cExisteRegistroRejeitado = 1;
    endif;
endif;

if (cExisteRegistroRejeitado=0);   
    if (sParenteN10 @<> sNivel1
        & sParenteN10 @<> sNivel2
        & sParenteN10 @<> sNivel3
        & sParenteN10 @<> sNivel4
        & sParenteN10 @<> sNivel5
        & sParenteN10 @<> sNivel6
        & sParenteN10 @<> sNivel7
        & sParenteN10 @<> sNivel8
        & sParenteN10 @<> sNivel9
        & sParenteN10 @<> cTotalizador); 
        cMensagemRegistro = 'O parente informado para o elemento  [ ' | vElement | ' ] não condiz com o parente já cadastrado na dimensão:  [  '| sParenteN10 |'  ].';
        cExisteRegistroRejeitado = 1;
    endif;
endif;

# ===================================================================================
# DEBUG ou REJEIÇÃO
# Registra em arquivo os registros
# ===================================================================================
If( cExisteRegistroRejeitado = 1  %  cUtilizarDebug @= 'S' );

    # Define o Cabeçalho - Debug / Rejeitado
    # ========================================
    if (cUtilizarDebug @= 'S'); 
        cCabeçalhoMensagem = 'Mensagem_Debug';
    else;
        cCabeçalhoMensagem = 'Mensagem_Rejeitado';
    endif;


    # Escreve o cabeçalho do arquivo de registros rejeitados
    # =================================================================================
    If( cExisteCabecalhoRejeitado = 0);
        CellPutS( cCabeçalhoMensagem , cCuboRejeitado , cProcesso , cUsuario , 'Cabeçalho do Arquivo' , 'Mensagem' );
        CellPutS( 'Linha De Registro'  , cCuboRejeitado , cProcesso , cUsuario , 'Cabeçalho do Arquivo' , 'Linha de Registro' );
        CellPutS('Elemento Mapa', cCuboRejeitado, cProcesso, cUsuario,'Cabeçalho do Arquivo', 'COL1');
        CellPutS('Nível 1', cCuboRejeitado, cProcesso, cUsuario,'Cabeçalho do Arquivo', 'COL2');
        CellPutS('Nível 2', cCuboRejeitado, cProcesso, cUsuario,'Cabeçalho do Arquivo', 'COL3');
        CellPutS('Nível 3', cCuboRejeitado, cProcesso, cUsuario,'Cabeçalho do Arquivo', 'COL4');
        CellPutS('Nível 4', cCuboRejeitado, cProcesso, cUsuario,'Cabeçalho do Arquivo', 'COL5');
        CellPutS('Nível 5', cCuboRejeitado, cProcesso, cUsuario,'Cabeçalho do Arquivo', 'COL6');
        CellPutS('Nível 6', cCuboRejeitado, cProcesso, cUsuario,'Cabeçalho do Arquivo', 'COL7');
        CellPutS('Nível 7', cCuboRejeitado, cProcesso, cUsuario,'Cabeçalho do Arquivo', 'COL8');
        CellPutS('Nível 8', cCuboRejeitado, cProcesso, cUsuario,'Cabeçalho do Arquivo', 'COL9');
        CellPutS('Nível 9', cCuboRejeitado, cProcesso, cUsuario,'Cabeçalho do Arquivo', 'COL10');
        CellPutS('Nível 10', cCuboRejeitado, cProcesso, cUsuario,'Cabeçalho do Arquivo', 'COL11');
        cExisteCabecalhoRejeitado = 1;
    EndIf;

    # Escreve o registro no arquivo de debug ou rejeitados
    # =================================================================================
    vLinhaRegistro = cContadorRegistro + 1;
    nLinhaRegistro = NumberToString( vLinhaRegistro);
    if ( cQtdRegistroRejeitadoCubo < cQtdRegistroRejeitadoMax);
        vLinha = TRIM( 'L' | NumberToString(cQtdRegistroRejeitadoCubo ));
        
        CellPutS( cMensagemRegistro , cCuboRejeitado , cProcesso , cUsuario , vLinha , 'Mensagem' );
        CellPutS( nLinhaRegistro  , cCuboRejeitado , cProcesso , cUsuario , vLinha , 'Linha de Registro' );        
        CellPutS( vElement, cCuboRejeitado, cProcesso, cUsuario,vLinha, 'COL1');
        CellPutS( sNivel1, cCuboRejeitado, cProcesso, cUsuario,vLinha, 'COL2');
        CellPutS( sNivel2, cCuboRejeitado, cProcesso, cUsuario,vLinha, 'COL3');
        CellPutS( sNivel3, cCuboRejeitado, cProcesso, cUsuario,vLinha, 'COL4');
        CellPutS( sNivel4, cCuboRejeitado, cProcesso, cUsuario,vLinha, 'COL5');
        CellPutS( sNivel5, cCuboRejeitado, cProcesso, cUsuario,vLinha, 'COL6');
        CellPutS( sNivel6, cCuboRejeitado, cProcesso, cUsuario,vLinha, 'COL7');
        CellPutS( sNivel7, cCuboRejeitado, cProcesso, cUsuario,vLinha, 'COL8');
        CellPutS( sNivel8, cCuboRejeitado, cProcesso, cUsuario,vLinha, 'COL9'); 
        CellPutS( sNivel9, cCuboRejeitado, cProcesso, cUsuario,vLinha, 'COL10');
        CellPutS( sNivel10, cCuboRejeitado, cProcesso, cUsuario,vLinha, 'COL11'); 
    endif;    
    
    
    # Limpa as variaveis e pula o registro
    # ============================
    IF( cExisteRegistroRejeitado = 1 );
         cExisteRegistroRejeitado = 0;
         cMensagemRegistro = '';
         cTipoErro = 2;
         cMensagemProcesso = ' Processo concluido com registros rejeitados, verificar o Cubo [ '| cCuboRejeitado | ' ] na Guia de rejeitados';
         cQtdRegistroRejeitadoCubo = cQtdRegistroRejeitadoCubo + 1;
         ItemSkip;
    EndIf;

EndIf;

# =================================================================================
# Atualiza hierarquia da dimensão 
# =================================================================================

sElm = vElement;
sDim = cDimensao;
sTot = cTotalizador;


# Nivel Total
# ==========================
If ( sNivel1 @<> '' );
    DimensionElementComponentAdd ( sDim, sTot, sNivel1, 1 );
ElseIf ( sNivel2 @<> '' );
